/// PPU: LCD レジスタ、モードタイミング、BG/ウィンドウ/スプライト描画(DMG)。
/// VRAM/OAM は Bus 側に持つ(Ppu 自体には持たない)。

/// LCDC(LCD Control、FF40)。
pub const LcdcAddr: uint16 = 0xFF40;
/// STAT(LCD Status、FF41)。
pub const StatAddr: uint16 = 0xFF41;
/// SCY(BGスクロールY、FF42)。
pub const ScyAddr: uint16 = 0xFF42;
/// SCX(BGスクロールX、FF43)。
pub const ScxAddr: uint16 = 0xFF43;
/// LY(現在の走査線、FF44、読み取り専用)。
pub const LyAddr: uint16 = 0xFF44;
/// LYC(LY比較値、FF45)。
pub const LycAddr: uint16 = 0xFF45;
/// BGP(BGパレット、FF47)。
pub const BgpAddr: uint16 = 0xFF47;
/// OBP0(スプライトパレット0、FF48)。
pub const Obp0Addr: uint16 = 0xFF48;
/// OBP1(スプライトパレット1、FF49)。
pub const Obp1Addr: uint16 = 0xFF49;
/// WY(ウィンドウY、FF4A)。
pub const WyAddr: uint16 = 0xFF4A;
/// WX(ウィンドウX+7、FF4B)。
pub const WxAddr: uint16 = 0xFF4B;

/// LCDC bit7: LCD/PPU 全体の有効化。
pub const LcdcBitLcdEnable: uint8 = 0x80;
/// LCDC bit6: ウィンドウタイルマップ選択(0=0x9800, 1=0x9C00)。
pub const LcdcBitWinMap: uint8 = 0x40;
/// LCDC bit5: ウィンドウ有効化。
pub const LcdcBitWinEnable: uint8 = 0x20;
/// LCDC bit4: BG/ウィンドウのタイルデータ基点選択(0=0x8800 signed, 1=0x8000 unsigned)。
pub const LcdcBitBgWinTiles: uint8 = 0x10;
/// LCDC bit3: BGタイルマップ選択(0=0x9800, 1=0x9C00)。
pub const LcdcBitBgMap: uint8 = 0x08;
/// LCDC bit2: スプライトサイズ(0=8x8, 1=8x16)。
pub const LcdcBitObjSize: uint8 = 0x04;
/// LCDC bit1: スプライト有効化。
pub const LcdcBitObjEnable: uint8 = 0x02;
/// LCDC bit0: BG/ウィンドウ有効化(DMG)。
pub const LcdcBitBgEnable: uint8 = 0x01;

/// STAT bit6: LYC一致割り込み許可。
pub const StatBitLycInt: uint8 = 0x40;
/// STAT bit5: モード2(OAM scan)割り込み許可。
pub const StatBitOamInt: uint8 = 0x20;
/// STAT bit4: モード1(VBlank)割り込み許可。
pub const StatBitVblankInt: uint8 = 0x10;
/// STAT bit3: モード0(HBlank)割り込み許可。
pub const StatBitHblankInt: uint8 = 0x08;
/// STAT bit2: LYC==LY の比較結果。
pub const StatBitLycEq: uint8 = 0x04;
/// STAT のうち書き込みが反映されるビット(bit6-3のみ)。
pub const StatWritableMask: uint8 = 0x78;

/// OAM属性 bit7: BG優先(BGカラー1-3の上に描画しない)。
pub const OamAttrBgPriority: uint8 = 0x80;
/// OAM属性 bit6: 垂直フリップ。
pub const OamAttrYFlip: uint8 = 0x40;
/// OAM属性 bit5: 水平フリップ。
pub const OamAttrXFlip: uint8 = 0x20;
/// OAM属性 bit4: パレット選択(0=OBP0, 1=OBP1)。
pub const OamAttrPalette: uint8 = 0x10;

/// CGB BG属性/OAM属性 共通 bit7: BGをOBJより前面にする(BG-to-OBJ優先度表で使用)。
pub const CgbAttrBgPriority: uint8 = 0x80;
/// CGB BG属性/OAM属性 共通 bit6: 垂直フリップ。
pub const CgbAttrYFlip: uint8 = 0x40;
/// CGB BG属性/OAM属性 共通 bit5: 水平フリップ。
pub const CgbAttrXFlip: uint8 = 0x20;
/// CGB BG属性/OAM属性 共通 bit3: タイルデータの読み出し元VRAMバンク(0/1)。
pub const CgbAttrBank: uint8 = 0x08;
/// CGB BG属性/OAM属性 共通 bit2-0: パレット番号(0-7)。
pub const CgbAttrPaletteMask: uint8 = 0x07;

/// PPU モード0(HBlank)。STAT bit1-0 と同じ数値。
pub const ModeHBlank: uint8 = 0;
/// PPU モード1(VBlank)。
pub const ModeVBlank: uint8 = 1;
/// PPU モード2(OAM scan)。
pub const ModeOamScan: uint8 = 2;
/// PPU モード3(描画)。
pub const ModeDraw: uint8 = 3;

const IntrVBlankBit: uint8 = 0x01;
const IntrStatBit: uint8 = 0x02;

/// DMGシェード0(最も明るい)。
pub const DmgShade0: uint32 = 0xFFFFFFFF;
/// DMGシェード1。
pub const DmgShade1: uint32 = 0xFFAAAAAA;
/// DMGシェード2。
pub const DmgShade2: uint32 = 0xFF555555;
/// DMGシェード3(最も暗い)。
pub const DmgShade3: uint32 = 0xFF000000;

/// 1ラインあたりの T-cycle 数。
pub const CyclesPerLine: int = 456;
/// モード2(OAM scan)の長さ(T-cycle)。
pub const Mode2Dots: int = 80;
/// モード3(描画)の長さ(T-cycle、固定長。可変長のペナルティは実装しない)。
pub const Mode3Dots: int = 172;
/// 1フレームのライン数(可視144 + VBlank10)。
pub const LinesPerFrame: int = 154;
/// VBlank突入ライン(LY=144)。
pub const VblankStartLine: int = 144;

/// PPU のレジスタ・内部状態・フレームバッファ一式。
pub struct Ppu {
    pub lcdc: uint8;
    pub statEnable: uint8;
    pub scy: uint8;
    pub scx: uint8;
    pub ly: uint8;
    pub lyc: uint8;
    pub bgp: uint8;
    pub obp0: uint8;
    pub obp1: uint8;
    pub wy: uint8;
    pub wx: uint8;

    pub mode: uint8;
    pub lycEqual: bool;
    pub dot: int;
    pub windowLine: int;
    pub statIrqLine: bool;

    pub framebuffer: uint32[23040]; // 160x144, ARGB, 行優先
    pub bgColorIndex: uint8[160]; // 直近描画したラインのカラー番号(パレット適用前)
    pub bgCgbPalette: uint8[160]; // CGB BG属性bit2-0(パレット番号)。DMGでは常に0
    pub bgCgbPriority: bool[160]; // CGB BG属性bit7(BG-to-OBJ優先)。DMGでは常にfalse
}

/// STAT bit2(LYC==LY)を LY/LYC の現在値から再計算する。
func PpuUpdateLycEqual(ppu: *var Ppu) {
    ppu.lycEqual = ppu.ly == ppu.lyc;
}

/// DMGブート後の PPU レジスタ初期値をセットする(実 BIOS ROM は読み込まない
/// 方針のため、post-boot 値を直接書き込む)。
pub func PpuPowerOn(ppu: *var Ppu) {
    ppu.lcdc = 0x91;
    ppu.statEnable = 0;
    ppu.scy = 0;
    ppu.scx = 0;
    ppu.lyc = 0;
    ppu.bgp = 0xFC;
    ppu.obp0 = 0xFF;
    ppu.obp1 = 0xFF;
    ppu.wy = 0;
    ppu.wx = 0;
    ppu.ly = 0;
    ppu.dot = 0;
    ppu.mode = ModeOamScan;
    ppu.windowLine = 0;
    ppu.statIrqLine = false;
    PpuUpdateLycEqual(ppu);
}

/// LCDC/STAT/SCY/SCX/LY/LYC/BGP/OBP0/OBP1/WY/WX の読み出し(FF46=OAM DMAは
/// Bus 側で処理するため対象外)。STAT はbit7固定1・LYC一致・モードを合成する。
pub func PpuRead(bus: *Bus, addr: uint16) -> uint8 {
    let ppu = @bus.ppu;
    if addr == LcdcAddr {
        return ppu.lcdc;
    } else if addr == StatAddr {
        var v: uint8 = 0x80 | ppu.statEnable | ppu.mode;
        if ppu.lycEqual {
            v = v | StatBitLycEq;
        }
        return v;
    } else if addr == ScyAddr {
        return ppu.scy;
    } else if addr == ScxAddr {
        return ppu.scx;
    } else if addr == LyAddr {
        return ppu.ly;
    } else if addr == LycAddr {
        return ppu.lyc;
    } else if addr == BgpAddr {
        return ppu.bgp;
    } else if addr == Obp0Addr {
        return ppu.obp0;
    } else if addr == Obp1Addr {
        return ppu.obp1;
    } else if addr == WyAddr {
        return ppu.wy;
    } else if addr == WxAddr {
        return ppu.wx;
    }
    return 0xFF;
}

/// LCDC bit7が0→1になったときの初期化(ラインの先頭から再開)。
func PpuEnable(ppu: *var Ppu) {
    ppu.ly = 0;
    ppu.dot = 0;
    ppu.mode = ModeOamScan;
    ppu.windowLine = 0;
    PpuUpdateLycEqual(ppu);
}

/// LCDC bit7が1→0になったときの状態固定(LY=0・モード0)。
func PpuDisable(ppu: *var Ppu) {
    ppu.ly = 0;
    ppu.dot = 0;
    ppu.mode = ModeHBlank;
    // 落とし穴(Mooneye stat_lyc_onoff): LCD off中はLYC比較器が止まるため、
    // STAT bit2(LYC==LY)は直前の値を保持し続ける(LY=0に対して再計算しない)。
    // 再計算が起きるのは PpuEnable(比較器の再起動)のときだけ。
}

/// STAT blocking用の「現在成立している割り込み条件の OR」を返す:
/// LYC一致・モード2・モード1(VBlank)・モード0(HBlank)。モード3には対応する
/// STAT割り込み源が無い。
func PpuStatConditionLine(ppu: *Ppu) -> bool {
    if ppu.lycEqual && (ppu.statEnable & StatBitLycInt) != 0 {
        return true;
    }
    if ppu.mode == ModeOamScan {
        return (ppu.statEnable & StatBitOamInt) != 0;
    } else if ppu.mode == ModeVBlank {
        return (ppu.statEnable & StatBitVblankInt) != 0;
    } else if ppu.mode == ModeHBlank {
        return (ppu.statEnable & StatBitHblankInt) != 0;
    }
    return false; // Draw
}

/// STAT blocking(立ち上がりエッジでのみ発火)を実装する。STAT/LYC/LCDCへの
/// 書き込み後と、PpuTickでのモード/LY変化後の両方で呼ぶ。
func PpuUpdateStatIrq(bus: *var Bus) {
    let line = PpuStatConditionLine(@bus.ppu);
    if line && !bus.ppu.statIrqLine {
        bus.io[0x0F] = bus.io[0x0F] | IntrStatBit;
    }
    bus.ppu.statIrqLine = line;
}

/// LCDC/STAT/SCY/SCX/LY/LYC/BGP/OBP0/OBP1/WY/WX の書き込み(FF46=OAM DMAは
/// Bus 側で処理するため対象外)。LYへの書き込みは無視する(リセットではない)。
pub func PpuWrite(bus: *var Bus, addr: uint16, value: uint8) {
    if addr == LcdcAddr {
        let wasEnabled = (bus.ppu.lcdc & LcdcBitLcdEnable) != 0;
        bus.ppu.lcdc = value;
        let nowEnabled = (bus.ppu.lcdc & LcdcBitLcdEnable) != 0;
        if !wasEnabled && nowEnabled {
            PpuEnable(@bus.ppu);
        } else if wasEnabled && !nowEnabled {
            PpuDisable(@bus.ppu);
        }
        PpuUpdateStatIrq(bus);
    } else if addr == StatAddr {
        bus.ppu.statEnable = value & StatWritableMask;
        PpuUpdateStatIrq(bus);
    } else if addr == ScyAddr {
        bus.ppu.scy = value;
    } else if addr == ScxAddr {
        bus.ppu.scx = value;
    } else if addr == LyAddr {
        // 読み取り専用: 書き込みは無視(リセットではない)
    } else if addr == LycAddr {
        bus.ppu.lyc = value;
        // 落とし穴(Mooneye stat_lyc_onoff): LCD off中はLYC比較器が止まっている
        // ため、LYC書き込みはSTAT bit2に反映されない。
        if (bus.ppu.lcdc & LcdcBitLcdEnable) != 0 {
            PpuUpdateLycEqual(@bus.ppu);
            PpuUpdateStatIrq(bus);
        }
    } else if addr == BgpAddr {
        bus.ppu.bgp = value;
    } else if addr == Obp0Addr {
        bus.ppu.obp0 = value;
    } else if addr == Obp1Addr {
        bus.ppu.obp1 = value;
    } else if addr == WyAddr {
        bus.ppu.wy = value;
    } else if addr == WxAddr {
        bus.ppu.wx = value;
    }
}

/// 現在の LY/dot から PPU モードを決める。
func PpuModeFor(ly: uint8, dot: int) -> uint8 {
    if (ly as int) >= VblankStartLine {
        return ModeVBlank;
    }
    if dot < Mode2Dots {
        return ModeOamScan;
    }
    if dot < Mode2Dots + Mode3Dots {
        return ModeDraw;
    }
    return ModeHBlank;
}

/// BGP/OBPnから取り出した2bitシェード番号(0-3)を DMG 4階調のARGBへ変換する。
func DmgShade(shade: uint8) -> uint32 {
    let s = shade & 0x03;
    if s == 0 {
        return DmgShade0;
    } else if s == 1 {
        return DmgShade1;
    } else if s == 2 {
        return DmgShade2;
    }
    return DmgShade3;
}

/// タイルインデックスからタイルデータの先頭アドレスを求める。
/// LCDC bit4=1: 0x8000起点のunsigned index。bit4=0: 0x9000起点のsigned index。
func BgTileDataAddr(lcdc: uint8, tileIndex: uint8, rowInTile: int) -> uint16 {
    if (lcdc & LcdcBitBgWinTiles) != 0 {
        return (0x8000 + (tileIndex as int) * 16 + rowInTile * 2) as uint16;
    }
    let signedIndex = (tileIndex as int8) as int;
    return (0x9000 + signedIndex * 16 + rowInTile * 2) as uint16;
}

/// VRAM上(指定バンク)の2bppタイルデータ1行から指定列のカラー番号(0-3、パレット
/// 適用前)を取り出す。bit7が左端ピクセル。CGBのBG/ウィンドウ/OBJいずれも属性
/// bit3(またはOAM属性bit3)でバンク0/1を選ぶ。
func TilePixelColorNumber(bus: *Bus, bank: uint8, tileAddr: uint16, colInTile: int) -> uint8 {
    // VramReadBank をインライン化(BG/ウィンドウ/スプライトの全ピクセルで
    // 呼ばれる最も熱いパスのため、Rux Releaseが関数インライン化を行わない
    // 問題への対策。Bus.rux の TimerTick と同じ方針)。
    let b = (bank & 0x01) as uint;
    let base = b * VramBankSize + (tileAddr - 0x8000) as uint;
    let low = bus.vram[base];
    let high = bus.vram[base + 1];
    let shift = (7 - colInTile) as uint;
    let lowBit = (low >> shift) & 0x01;
    let highBit = (high >> shift) & 0x01;
    return lowBit | (highBit << 1);
}

/// タイルマップ1ピクセル分の解決結果。DMGモードでは palette=0・priority=false 固定
/// (属性バイトはCGBモードのときだけバンク1から読む)。
pub struct BgPixel {
    pub colorNumber: uint8;
    pub palette: uint8;
    pub priority: bool;
}

/// タイルマップ(BG/ウィンドウ共通の形式)上の座標(sourceX, sourceY)が指すタイル
/// のピクセルを解決する。CGBモードでは「バンク1のタイルマップと同アドレス」
/// (落とし穴)から属性バイトを読み、Y/Xフリップとタイルデータバンク選択に反映する。
func TileMapPixel(bus: *Bus, mapBase: uint16, lcdc: uint8, sourceX: int, sourceY: int) -> BgPixel {
    let tileCol = sourceX / 8;
    let tileRow = sourceY / 8;
    let tileMapAddr = mapBase + ((tileRow * 32 + tileCol) as uint16);
    // VramReadBank をインライン化(バンクは呼び出し側で0/1固定のため)。
    let tileIndex = bus.vram[(tileMapAddr - 0x8000) as uint];

    var attr: uint8 = 0;
    if bus.mode == GbMode::Cgb {
        attr = bus.vram[VramBankSize + (tileMapAddr - 0x8000) as uint];
    }

    var rowInTile = sourceY % 8;
    var colInTile = sourceX % 8;
    if (attr & CgbAttrYFlip) != 0 {
        rowInTile = 7 - rowInTile;
    }
    if (attr & CgbAttrXFlip) != 0 {
        colInTile = 7 - colInTile;
    }

    var tileBank: uint8 = 0;
    if (attr & CgbAttrBank) != 0 {
        tileBank = 1;
    }

    let tileAddr = BgTileDataAddr(lcdc, tileIndex, rowInTile);
    let colorNumber = TilePixelColorNumber(bus, tileBank, tileAddr, colInTile);

    return BgPixel {
        colorNumber: colorNumber,
        palette: attr & CgbAttrPaletteMask,
        priority: (attr & CgbAttrBgPriority) != 0
    };
}

/// CGBパレットRAMの1色(リトルエンディアン2バイト、bit4-0=R, 9-5=G, 14-10=B)を
/// ARGBへ変換する(architecture.md固定の変換式 `(c<<3)|(c>>2)`)。
func Rgb555ToArgb(raw: uint16) -> uint32 {
    let r = (raw & 0x1F) as uint32;
    let g = ((raw >> 5) & 0x1F) as uint32;
    let b = ((raw >> 10) & 0x1F) as uint32;
    let rr = (r << 3) | (r >> 2);
    let gg = (g << 3) | (g >> 2);
    let bb = (b << 3) | (b >> 2);
    return 0xFF000000 | (rr << 16) | (gg << 8) | bb;
}

/// パレットRAM(BG/OBJいずれか)からpalette番号(0-7)・colorNumber(0-3)の色を
/// 引きARGBへ変換する。1色=2バイト、パレット1本=8バイト(4色×2バイト)。
func CgbPaletteColor(bus: *Bus, useObjPalette: bool, palette: uint8, colorNumber: uint8) -> uint32 {
    let index = ((palette & 0x07) as uint) * 8 + ((colorNumber & 0x03) as uint) * 2;
    var low: uint8 = 0;
    var high: uint8 = 0;
    if useObjPalette {
        low = bus.objPaletteRam[index];
        high = bus.objPaletteRam[index + 1];
    } else {
        low = bus.bgPaletteRam[index];
        high = bus.bgPaletteRam[index + 1];
    }
    let raw = (low as uint16) | ((high as uint16) << 8);
    return Rgb555ToArgb(raw);
}

/// 1ライン分をframebufferに描く(BG→ウィンドウ→スプライトの順)。
/// LCDC bit0=0のときBG・ウィンドウとも白一色になる(DMGではbit0がBG&ウィンドウ
/// 全体の有効/無効を兼ねる)。スプライトはbit0とは独立にbit1で制御される。
func PpuRenderScanline(bus: *var Bus) {
    let ly = bus.ppu.ly as int;
    if ly >= 144 {
        return;
    }
    let lineStart = (ly * 160) as uint;

    // 落とし穴(T6-5): CGBモードではLCDC bit0の意味が変わり「BG/ウィンドウの
    // マスタープライオリティ」になる(0でもBG/ウィンドウは通常どおり描画され続け、
    // OBJが常にBGより前面になるだけ。Pan Docs "LCDC.0")。白一色化はDMGモード限定。
    if bus.mode != GbMode::Cgb && (bus.ppu.lcdc & LcdcBitBgEnable) == 0 {
        var x: uint = 0;
        while x < 160 {
            bus.ppu.framebuffer[lineStart + x] = DmgShade0;
            bus.ppu.bgColorIndex[x] = 0;
            bus.ppu.bgCgbPalette[x] = 0;
            bus.ppu.bgCgbPriority[x] = false;
            x += 1;
        }
        PpuRenderSprites(bus, lineStart);
        return;
    }

    var bgMapBase: uint16 = 0x9800;
    if (bus.ppu.lcdc & LcdcBitBgMap) != 0 {
        bgMapBase = 0x9C00;
    }

    var winMapBase: uint16 = 0x9800;
    if (bus.ppu.lcdc & LcdcBitWinMap) != 0 {
        winMapBase = 0x9C00;
    }

    let winEnabled = (bus.ppu.lcdc & LcdcBitWinEnable) != 0;
    let wxMinus7 = (bus.ppu.wx as int) - 7;
    let winVisibleThisLine = winEnabled && ly >= (bus.ppu.wy as int) && wxMinus7 < 160;

    // 落とし穴(性能): TileMapPixelを毎ピクセル呼ぶと、同じタイル内の8ピクセル
    // すべてでタイルマップ/属性/タイルデータのVRAM読み出しを重複して行う
    // ことになる(Rux Releaseが関数インライン化を行わない問題も重なり特に高コスト。
    // Bus.rux の TimerTick と同じ対策方針)。タイル列(tileCol)とソース
    // (BG/ウィンドウ)が変わったときだけタイルデータを取得し直す1ピクセル
    // フェッチャー相当のキャッシュに書き換えた。結果はTileMapPixelを毎回
    // 呼んだ場合と同一(dmg-acid2/cgb-acid2でピクセル完全一致を確認)。
    var x: uint = 0;
    var haveTile = false;
    var curTileCol: int = -1;
    var curMapBase: uint16 = 0;
    var curIsWindow = false;
    var lowByte: uint8 = 0;
    var highByte: uint8 = 0;
    var tileXFlip = false;
    var tilePalette: uint8 = 0;
    var tilePriority = false;

    while x < 160 {
        let useWindow = winVisibleThisLine && (x as int) >= wxMinus7;
        var sourceX: int;
        var sourceY: int;
        var mapBase: uint16;
        if useWindow {
            sourceX = (x as int) - wxMinus7;
            sourceY = bus.ppu.windowLine;
            mapBase = winMapBase;
        } else {
            sourceX = ((x as int) + (bus.ppu.scx as int)) & 0xFF;
            sourceY = (ly + (bus.ppu.scy as int)) & 0xFF;
            mapBase = bgMapBase;
        }

        let tileCol = sourceX / 8;

        if !haveTile || tileCol != curTileCol || mapBase != curMapBase || useWindow != curIsWindow {
            let tileRow = sourceY / 8;
            let tileMapAddr = mapBase + ((tileRow * 32 + tileCol) as uint16);
            let tileIndex = bus.vram[(tileMapAddr - 0x8000) as uint];

            var attr: uint8 = 0;
            if bus.mode == GbMode::Cgb {
                attr = bus.vram[VramBankSize + (tileMapAddr - 0x8000) as uint];
            }

            var rowInTile = sourceY % 8;
            if (attr & CgbAttrYFlip) != 0 {
                rowInTile = 7 - rowInTile;
            }

            var tileBank: uint = 0;
            if (attr & CgbAttrBank) != 0 {
                tileBank = 1;
            }

            let tileAddr = BgTileDataAddr(bus.ppu.lcdc, tileIndex, rowInTile);
            let base = tileBank * VramBankSize + (tileAddr - 0x8000) as uint;
            lowByte = bus.vram[base];
            highByte = bus.vram[base + 1];
            tileXFlip = (attr & CgbAttrXFlip) != 0;
            tilePalette = attr & CgbAttrPaletteMask;
            tilePriority = (attr & CgbAttrBgPriority) != 0;

            curTileCol = tileCol;
            curMapBase = mapBase;
            curIsWindow = useWindow;
            haveTile = true;
        }

        var colInTile = sourceX % 8;
        if tileXFlip {
            colInTile = 7 - colInTile;
        }
        let shift = (7 - colInTile) as uint;
        let colorNumber = ((lowByte >> shift) & 0x01) | (((highByte >> shift) & 0x01) << 1);

        bus.ppu.bgColorIndex[x] = colorNumber;
        bus.ppu.bgCgbPalette[x] = tilePalette;
        bus.ppu.bgCgbPriority[x] = tilePriority;
        if bus.mode == GbMode::Cgb {
            bus.ppu.framebuffer[lineStart + x] = CgbPaletteColor(bus, false, tilePalette, colorNumber);
        } else {
            let shade = (bus.ppu.bgp >> (colorNumber * 2)) & 0x03;
            bus.ppu.framebuffer[lineStart + x] = DmgShade(shade);
        }
        x += 1;
    }

    if winVisibleThisLine {
        bus.ppu.windowLine += 1;
    }

    PpuRenderSprites(bus, lineStart);
}

/// CGBのBG-to-OBJ優先度表(Pan Docs "BG-to-OBJ Priority in CGB Mode")。
/// trueならOBJを描画してよい、falseならBGを残す(OBJ側のcolorNumber=0=透明は
/// 呼び出し側で既に除外済みの前提)。優先順: (1) LCDC bit0=0(マスタープライオリティ
/// 無効)ならOBJが常に勝つ。(2) BGのcolorNumberが0(透明)ならOBJが勝つ。
/// (3) BG属性bit7(bgPriority)が立っていればBGが勝つ。(4) OAM属性bit7(oamPriority)
/// が立っていればBGが勝つ。(5) それ以外はOBJが勝つ。
func CgbObjWinsOverBg(ppu: *Ppu, bgColorNumber: uint8, bgPriority: bool, oamPriority: bool) -> bool {
    if (ppu.lcdc & LcdcBitBgEnable) == 0 { return true; }
    if bgColorNumber == 0 { return true; }
    if bgPriority { return false; }
    if oamPriority { return false; }
    return true;
}

/// このラインのスプライト(8x8/8x16)を優先度込みで描画する。
/// OAM先頭から最大10個/ラインを収集し、DMGの優先度(X座標が小さいスプライトが
/// 勝つ、同Xなら OAM 順)でソートする。一度確定したピクセルは他のスプライトに
/// 上書きされない。スプライトのカラー0は常に透明。
func PpuRenderSprites(bus: *var Bus, lineStart: uint) {
    if (bus.ppu.lcdc & LcdcBitObjEnable) == 0 {
        return;
    }

    var spriteHeight: int = 8;
    if (bus.ppu.lcdc & LcdcBitObjSize) != 0 {
        spriteHeight = 16;
    }

    // OAM 収集(先着10個、OAM順)。X座標で挿入ソートし、同Xなら OAM 順。
    var spriteIndex: int[10];
    var spriteX: int[10];
    var spriteY: int[10];
    var spriteTile: uint8[10];
    var spriteAttr: uint8[10];
    var count: int = 0;

    let ly = bus.ppu.ly as int;
    var i: int = 0;
    while i < 40 && count < 10 {
        let base = (i * 4) as uint;
        let y = (bus.oam[base + 0] as int) - 16;
        let yInSprite = ly - y;
        if yInSprite >= 0 && yInSprite < spriteHeight {
            spriteIndex[count] = i;
            spriteX[count] = (bus.oam[base + 1] as int) - 8;
            spriteY[count] = y;
            spriteTile[count] = bus.oam[base + 2];
            spriteAttr[count] = bus.oam[base + 3];
            count += 1;
        }
        i += 1;
    }

    if count == 0 {
        return;
    }

    // 挿入ソート: X優先、同Xなら OAM index 優先(小さい方が勝つ)。
    // 落とし穴(T6-5): CGBはX座標に関係なくOAM順(先頭が勝つ)なのでソートしない
    // (上の収集ループが既にOAM index0からの走査順で詰めている)。
    if bus.mode != GbMode::Cgb {
    var j: int = 1;
    while j < count {
        let curIndex = spriteIndex[j];
        let curX = spriteX[j];
        let curY = spriteY[j];
        let curTile = spriteTile[j];
        let curAttr = spriteAttr[j];
        var k = j - 1;
        while k >= 0 && (spriteX[k] > curX || (spriteX[k] == curX && spriteIndex[k] > curIndex)) {
            spriteIndex[k + 1] = spriteIndex[k];
            spriteX[k + 1] = spriteX[k];
            spriteY[k + 1] = spriteY[k];
            spriteTile[k + 1] = spriteTile[k];
            spriteAttr[k + 1] = spriteAttr[k];
            k -= 1;
        }
        spriteIndex[k + 1] = curIndex;
        spriteX[k + 1] = curX;
        spriteY[k + 1] = curY;
        spriteTile[k + 1] = curTile;
        spriteAttr[k + 1] = curAttr;
        j += 1;
    }
    }

    var pixelOwned: bool[160];
    var p: uint = 0;
    while p < 160 {
        pixelOwned[p] = false;
        p += 1;
    }

    var s: int = 0;
    while s < count {
        var tileIndex = spriteTile[s];
        if spriteHeight == 16 {
            tileIndex = tileIndex & 0xFE;
        }
        let attr = spriteAttr[s];

        var yInSprite = ly - spriteY[s];
        if (attr & OamAttrYFlip) != 0 {
            yInSprite = spriteHeight - 1 - yInSprite;
        }
        var tileOffset: uint8 = 0;
        if spriteHeight == 16 && yInSprite >= 8 {
            tileOffset = 1;
        }
        let rowInTile = yInSprite % 8;
        let tileAddr = (0x8000 + ((tileIndex + tileOffset) as int) * 16 + rowInTile * 2) as uint16;

        // CGBのOAM属性bit3はタイルデータの読み出し元VRAMバンクを選ぶ(DMGでは無視、
        // バンク0固定)。
        var spriteTileBank: uint = 0;
        if bus.mode == GbMode::Cgb && (attr & CgbAttrBank) != 0 {
            spriteTileBank = 1;
        }

        // 落とし穴(性能): tileAddr(延いてはこの2バイト)は列ループ全体で不変
        // なのに、TilePixelColorNumberを列ごとに呼ぶと8列すべてで同じVRAM
        // バイトを読み直すことになる。BGループと同じ理由でループ外へ1回だけ
        // 出す(Bus.rux の TimerTick 参照)。
        let tileBase = spriteTileBank * VramBankSize + (tileAddr - 0x8000) as uint;
        let rowLow = bus.vram[tileBase];
        let rowHigh = bus.vram[tileBase + 1];

        var col: int = 0;
        while col < 8 {
            let x = spriteX[s] + col;
            if x >= 0 && x < 160 && !pixelOwned[x as uint] {
                var sourceCol = col;
                if (attr & OamAttrXFlip) != 0 {
                    sourceCol = 7 - col;
                }
                let shift = (7 - sourceCol) as uint;
                let colorNumber = ((rowLow >> shift) & 0x01) | (((rowHigh >> shift) & 0x01) << 1);
                if colorNumber != 0 {
                    pixelOwned[x as uint] = true;

                    var draw = true;
                    if bus.mode == GbMode::Cgb {
                        if !CgbObjWinsOverBg(@bus.ppu, bus.ppu.bgColorIndex[x as uint], bus.ppu.bgCgbPriority[x as uint], (attr & OamAttrBgPriority) != 0) {
                            draw = false;
                        }
                    } else if (attr & OamAttrBgPriority) != 0 && bus.ppu.bgColorIndex[x as uint] != 0 {
                        draw = false;
                    }

                    if draw {
                        if bus.mode == GbMode::Cgb {
                            let cgbPalette = attr & CgbAttrPaletteMask;
                            bus.ppu.framebuffer[lineStart + (x as uint)] = CgbPaletteColor(bus, true, cgbPalette, colorNumber);
                        } else {
                            var palette = bus.ppu.obp0;
                            if (attr & OamAttrPalette) != 0 {
                                palette = bus.ppu.obp1;
                            }
                            let shade = (palette >> (colorNumber * 2)) & 0x03;
                            bus.ppu.framebuffer[lineStart + (x as uint)] = DmgShade(shade);
                        }
                    }
                }
            }
            col += 1;
        }
        s += 1;
    }
}

/// tCycles ぶん PPU の状態を進める。LY/モード遷移のエッジをまたぐ変化を
/// 見落とさないため1 T-cycleずつ進める。LCDC bit7=0の間は完全に停止する。
///
/// 落とし穴(性能): CPU全メモリアクセスごとに呼ばれる最も熱いパスの一つ。
/// PpuUpdateStatIrq が見る statIrqLine は lycEqual(LY==LYC の一致、dot が
/// ラインを跨いだときだけ再計算される)と mode(モード遷移時だけ変わる)にのみ
/// 依存するため、そのどちらも変化しなかった T-cycle では呼んでも結果は
/// 不変。1 T-cycleごと(1ラインにつき456回)呼んでいたのを、ラインが進んだ
/// ときとモードが遷移したときだけ(1ラインにつき数回)に絞った。
/// TimerTick と同じ対策方針(Bus.rux 参照)。
pub func PpuTick(bus: *var Bus, tCycles: int) {
    if (bus.ppu.lcdc & LcdcBitLcdEnable) == 0 {
        return;
    }

    // 最適化前(参考): dot/ly/mode を毎回 bus.ppu.* に直接読み書きしていた。
    // Rux Release は mem2reg 相当の最適化(スタック/構造体メモリ上の変数を
    // レジスタへ昇格する処理)を行わないため、ループ内で同じフィールドへ
    // 繰り返し触れるコードはそのまま「毎回メモリを読み直し・書き直す」機械語に
    // 直訳される。1 T-cycleごと(1ラインにつき456回)実行される最も熱いループ
    // なので影響が大きい(CpuPerfベンチ+逆アセンブルで確認)。
    //
    // var cycle: int = 0;
    // while cycle < tCycles {
    //     let prevMode = bus.ppu.mode;
    //     var lineAdvanced = false;
    //     bus.ppu.dot += 1;
    //     if bus.ppu.dot >= CyclesPerLine {
    //         bus.ppu.dot = 0;
    //         bus.ppu.ly += 1;
    //         if (bus.ppu.ly as int) >= LinesPerFrame {
    //             bus.ppu.ly = 0;
    //             bus.ppu.windowLine = 0;
    //         }
    //         PpuUpdateLycEqual(@bus.ppu);
    //         lineAdvanced = true;
    //     }
    //     // PpuModeFor をインライン化(呼び出しオーバーヘッド削減)
    //     let ly = bus.ppu.ly;
    //     let dot = bus.ppu.dot;
    //     var mode: uint8 = ModeHBlank;
    //     if (ly as int) >= VblankStartLine {
    //         mode = ModeVBlank;
    //     } else if dot < Mode2Dots {
    //         mode = ModeOamScan;
    //     } else if dot < Mode2Dots + Mode3Dots {
    //         mode = ModeDraw;
    //     }
    //     bus.ppu.mode = mode;
    //
    //     if prevMode != ModeVBlank && bus.ppu.mode == ModeVBlank {
    //         bus.io[0x0F] = bus.io[0x0F] | IntrVBlankBit;
    //     }
    //     if prevMode == ModeDraw && bus.ppu.mode == ModeHBlank {
    //         PpuRenderScanline(bus);
    //         HdmaOnHblank(bus); // T6-7: HDMA(HBlank毎16バイト転送)のフック
    //     }
    //
    //     if lineAdvanced || prevMode != bus.ppu.mode {
    //         PpuUpdateStatIrq(bus);
    //     }
    //     cycle += 1;
    // }

    // dot/ly/mode/windowLine をループの外で一度だけローカル変数へ読み出し、
    // ループ内はローカル変数だけで計算する(Rux Releaseがmem2reg相当を
    // 行わない対策。Bus.rux の TimerTick と同じ方針)。
    // PpuRenderScanline/PpuUpdateLycEqual/PpuUpdateStatIrq は bus.ppu の
    // dot/ly/mode/windowLine を読む(またはPpuRenderScanlineはwindowLineを
    // 書く)ため、呼ぶ直前にローカル→bus.ppuへ同期し、windowLineは呼んだ
    // 直後にbus.ppu→ローカルへ読み戻す。HdmaOnHblankはbus.ppuに触れないため
    // 同期不要。
    var dot = bus.ppu.dot;
    var ly = bus.ppu.ly;
    var mode = bus.ppu.mode;
    var windowLine = bus.ppu.windowLine;

    var cycle: int = 0;
    while cycle < tCycles {
        let prevMode = mode;
        var lineAdvanced = false;
        dot += 1;
        if dot >= CyclesPerLine {
            dot = 0;
            ly += 1;
            if (ly as int) >= LinesPerFrame {
                ly = 0;
                windowLine = 0;
            }
            bus.ppu.ly = ly; // PpuUpdateLycEqualが読むため同期
            PpuUpdateLycEqual(@bus.ppu);
            lineAdvanced = true;
        }
        // PpuModeFor をインライン化(呼び出しオーバーヘッド削減)
        var newMode: uint8 = ModeHBlank;
        if (ly as int) >= VblankStartLine {
            newMode = ModeVBlank;
        } else if dot < Mode2Dots {
            newMode = ModeOamScan;
        } else if dot < Mode2Dots + Mode3Dots {
            newMode = ModeDraw;
        }
        mode = newMode;

        if prevMode != ModeVBlank && mode == ModeVBlank {
            bus.io[0x0F] = bus.io[0x0F] | IntrVBlankBit;
        }
        if prevMode == ModeDraw && mode == ModeHBlank {
            bus.ppu.dot = dot;
            bus.ppu.ly = ly;
            bus.ppu.mode = mode;
            bus.ppu.windowLine = windowLine;
            PpuRenderScanline(bus);
            HdmaOnHblank(bus); // T6-7: HDMA(HBlank毎16バイト転送)のフック
            windowLine = bus.ppu.windowLine; // PpuRenderScanlineが更新するため読み戻す
        }

        if lineAdvanced || prevMode != mode {
            bus.ppu.dot = dot;
            bus.ppu.ly = ly;
            bus.ppu.mode = mode;
            PpuUpdateStatIrq(bus);
        }
        cycle += 1;
    }

    bus.ppu.dot = dot;
    bus.ppu.ly = ly;
    bus.ppu.mode = mode;
    bus.ppu.windowLine = windowLine;
}
