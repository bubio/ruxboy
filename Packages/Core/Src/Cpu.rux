/// SM83 CPU (Game Boy / Game Boy Color)。M-cycle 粒度で駆動する。

/// F レジスタ bit7: Zero フラグ。
pub const FlagZ: uint8 = 0x80;
/// F レジスタ bit6: Subtract フラグ。
pub const FlagN: uint8 = 0x40;
/// F レジスタ bit5: Half carry フラグ。
pub const FlagH: uint8 = 0x20;
/// F レジスタ bit4: Carry フラグ。
pub const FlagC: uint8 = 0x10;

/// SM83 CPU のレジスタ・内部状態一式。
pub struct Cpu {
    pub a: uint8;
    pub f: uint8;
    pub b: uint8;
    pub c: uint8;
    pub d: uint8;
    pub e: uint8;
    pub h: uint8;
    pub l: uint8;
    pub sp: uint16;
    pub pc: uint16;
    pub ime: bool;
    pub halted: bool;
    pub haltBug: bool;
    pub imeDelay: int;
    pub stopped: bool;
    pub illegalOpcodeHit: bool;
    pub debugBreakOnLdBb: bool;
    pub ldBbHit: bool;
}

// --- 16bit レジスタペアアクセス ---
// F の下位 4bit は常に 0 にマスクする

/// AF レジスタペアを読む。
pub func CpuAf(cpu: *Cpu) -> uint16 {
    return (cpu.a as uint16 << 8) | (cpu.f as uint16);
}

/// AF レジスタペアへ書く(F の下位4bitは常に0にマスクされる)。
pub func CpuSetAf(cpu: *var Cpu, v: uint16) {
    cpu.a = (v >> 8) as uint8;
    cpu.f = (v as uint8) & 0xF0;
}

/// BC レジスタペアを読む。
pub func CpuBc(cpu: *Cpu) -> uint16 {
    return (cpu.b as uint16 << 8) | (cpu.c as uint16);
}

/// BC レジスタペアへ書く。
pub func CpuSetBc(cpu: *var Cpu, v: uint16) {
    cpu.b = (v >> 8) as uint8;
    cpu.c = v as uint8;
}

/// DE レジスタペアを読む。
pub func CpuDe(cpu: *Cpu) -> uint16 {
    return (cpu.d as uint16 << 8) | (cpu.e as uint16);
}

/// DE レジスタペアへ書く。
pub func CpuSetDe(cpu: *var Cpu, v: uint16) {
    cpu.d = (v >> 8) as uint8;
    cpu.e = v as uint8;
}

/// HL レジスタペアを読む。
pub func CpuHl(cpu: *Cpu) -> uint16 {
    return (cpu.h as uint16 << 8) | (cpu.l as uint16);
}

/// HL レジスタペアへ書く。
pub func CpuSetHl(cpu: *var Cpu, v: uint16) {
    cpu.h = (v >> 8) as uint8;
    cpu.l = v as uint8;
}

// --- フラグ操作 ---

/// Z/N/H/C の4フラグをまとめて設定する(F の下位4bitは0固定)。
pub func CpuSetFlags(cpu: *var Cpu, z: bool, n: bool, h: bool, c: bool) {
    var f: uint8 = 0;
    if z { f = f | FlagZ; }
    if n { f = f | FlagN; }
    if h { f = f | FlagH; }
    if c { f = f | FlagC; }
    cpu.f = f;
}

/// Zero フラグを読む。
pub func CpuFlagZ(cpu: *Cpu) -> bool {
    return (cpu.f & FlagZ) != 0;
}

/// Subtract フラグを読む。
pub func CpuFlagN(cpu: *Cpu) -> bool {
    return (cpu.f & FlagN) != 0;
}

/// Half carry フラグを読む。
pub func CpuFlagH(cpu: *Cpu) -> bool {
    return (cpu.f & FlagH) != 0;
}

/// Carry フラグを読む。
pub func CpuFlagC(cpu: *Cpu) -> bool {
    return (cpu.f & FlagC) != 0;
}

/// ブート ROM 完了直後のレジスタ状態を直接セットする(実 BIOS を読み込まない
/// 方針のため、DMG/CGB それぞれの post-boot 値を固定で書き込む)。
pub func CpuReset(cpu: *var Cpu, mode: GbMode) {
    if mode == GbMode::Dmg {
        CpuSetAf(cpu, 0x01B0);
        CpuSetBc(cpu, 0x0013);
        CpuSetDe(cpu, 0x00D8);
        CpuSetHl(cpu, 0x014D);
    } else {
        CpuSetAf(cpu, 0x1180);
        CpuSetBc(cpu, 0x0000);
        CpuSetDe(cpu, 0xFF56);
        CpuSetHl(cpu, 0x000D);
    }
    cpu.sp = 0xFFFE;
    cpu.pc = 0x0100;
    cpu.ime = false;
    cpu.halted = false;
    cpu.haltBug = false;
    cpu.imeDelay = 0;
    cpu.stopped = false;
    cpu.illegalOpcodeHit = false;
    cpu.debugBreakOnLdBb = false;
    cpu.ldBbHit = false;
}

/// 未定義オペコードを検知したときの共通処理(停止扱いにする)。
func CpuLogIllegal(cpu: *var Cpu, opcode: uint8) {
    cpu.illegalOpcodeHit = true;
    cpu.stopped = true;
}

// --- フェッチヘルパー ---

/// PC の指すバイトを読み、PC を1進める。
func ReadImm8(cpu: *var Cpu, bus: *var Bus) -> uint8 {
    let v = CpuRead8(cpu, bus, cpu.pc);
    cpu.pc += 1;
    return v;
}

/// PC の指す2バイト(リトルエンディアン)を読み、PC を2進める。
func ReadImm16(cpu: *var Cpu, bus: *var Bus) -> uint16 {
    let lo = ReadImm8(cpu, bus);
    let hi = ReadImm8(cpu, bus);
    return (hi as uint16 << 8) | (lo as uint16);
}

// --- r8 インデックス (0=B,1=C,2=D,3=E,4=H,5=L,6=(HL),7=A) ---

/// r8 インデックスからレジスタ(または (HL))の値を読む。
func R8Get(cpu: *var Cpu, bus: *var Bus, idx: uint8) -> uint8 {
    if idx == 0 { return cpu.b; }
    else if idx == 1 { return cpu.c; }
    else if idx == 2 { return cpu.d; }
    else if idx == 3 { return cpu.e; }
    else if idx == 4 { return cpu.h; }
    else if idx == 5 { return cpu.l; }
    else if idx == 6 { return CpuRead8(cpu, bus, CpuHl(cpu)); }
    else { return cpu.a; }
}

/// r8 インデックスへレジスタ(または (HL))の値を書く。
func R8Set(cpu: *var Cpu, bus: *var Bus, idx: uint8, v: uint8) {
    if idx == 0 { cpu.b = v; }
    else if idx == 1 { cpu.c = v; }
    else if idx == 2 { cpu.d = v; }
    else if idx == 3 { cpu.e = v; }
    else if idx == 4 { cpu.h = v; }
    else if idx == 5 { cpu.l = v; }
    else if idx == 6 { CpuWrite8(cpu, bus, CpuHl(cpu), v); }
    else { cpu.a = v; }
}

// --- rp16 インデックス (0=BC,1=DE,2=HL,3=SP) ---

/// rp16 インデックスから16bitレジスタペアを読む。
func RpGet(cpu: *Cpu, idx: uint8) -> uint16 {
    if idx == 0 { return CpuBc(cpu); }
    else if idx == 1 { return CpuDe(cpu); }
    else if idx == 2 { return CpuHl(cpu); }
    else { return cpu.sp; }
}

/// rp16 インデックスへ16bitレジスタペアを書く。
func RpSet(cpu: *var Cpu, idx: uint8, v: uint16) {
    if idx == 0 { CpuSetBc(cpu, v); }
    else if idx == 1 { CpuSetDe(cpu, v); }
    else if idx == 2 { CpuSetHl(cpu, v); }
    else { cpu.sp = v; }
}

// --- rp2 インデックス (PUSH/POP 用。0=BC,1=DE,2=HL,3=AF) ---

/// rp2 インデックス(PUSH/POP用)から16bitレジスタペアを読む。
func Rp2Get(cpu: *Cpu, idx: uint8) -> uint16 {
    if idx == 3 { return CpuAf(cpu); }
    return RpGet(cpu, idx);
}

/// rp2 インデックス(PUSH/POP用)へ16bitレジスタペアを書く。
func Rp2Set(cpu: *var Cpu, idx: uint8, v: uint16) {
    if idx == 3 {
        CpuSetAf(cpu, v);
        return;
    }
    RpSet(cpu, idx, v);
}

// --- 条件コード (0=NZ,1=Z,2=NC,3=C) ---

/// 条件コードインデックスを評価する。
func CcTest(cpu: *Cpu, idx: uint8) -> bool {
    if idx == 0 { return !CpuFlagZ(cpu); }
    else if idx == 1 { return CpuFlagZ(cpu); }
    else if idx == 2 { return !CpuFlagC(cpu); }
    else { return CpuFlagC(cpu); }
}

// --- スタック操作 ---

/// SP を2減らし、16bit値をスタックへ push する。
func Push16(cpu: *var Cpu, bus: *var Bus, v: uint16) {
    cpu.sp -= 1;
    CpuWrite8(cpu, bus, cpu.sp, (v >> 8) as uint8);
    cpu.sp -= 1;
    CpuWrite8(cpu, bus, cpu.sp, v as uint8);
}

/// スタックから16bit値を pop し、SP を2増やす。
func Pop16(cpu: *var Cpu, bus: *var Bus) -> uint16 {
    let lo = CpuRead8(cpu, bus, cpu.sp);
    cpu.sp += 1;
    let hi = CpuRead8(cpu, bus, cpu.sp);
    cpu.sp += 1;
    return (hi as uint16 << 8) | (lo as uint16);
}

/// ADD SP,e8 / LD HL,SP+e8 共通のフラグ計算。Z=0, N=0 固定。H/C は SP の
/// 下位バイトに符号なしの e8 を加算した結果の桁上がりで決まる。
func SpAddOffset(cpu: *var Cpu, bus: *var Bus) -> uint16 {
    let e8 = ReadImm8(cpu, bus);
    let sp = cpu.sp;
    let e8u = e8 as uint16;

    let h = ((sp & 0xF) + (e8u & 0xF)) > 0xF;
    let c = ((sp & 0xFF) + (e8u & 0xFF)) > 0xFF;
    CpuSetFlags(cpu, false, false, h, c);

    // 符号付き加算 (e8 as int8)
    if (e8 & 0x80) != 0 {
        let negOffset = (0x100 - (e8 as uint)) as uint16;
        return sp - negOffset;
    } else {
        return sp + e8u;
    }
}

// --- 8bit ALU ヘルパー ---

/// ADD/ADC A,v。
func AluAdd(cpu: *var Cpu, v: uint8, carryIn: uint) {
    let a = cpu.a as uint;
    let sum = a + (v as uint) + carryIn;
    let h = ((a & 0xF) + ((v as uint) & 0xF) + carryIn) > 0xF;
    cpu.a = sum as uint8;
    CpuSetFlags(cpu, cpu.a == 0, false, h, sum > 0xFF);
}

/// SUB/SBC/CP A,v。`store=false` のとき CP として結果をAへ書き戻さない。
func AluSub(cpu: *var Cpu, v: uint8, carryIn: uint, store: bool) {
    let a = cpu.a as uint;
    let subtrahend = (v as uint) + carryIn;
    let diff = (a + 0x100 - subtrahend) & 0xFF;
    let h = (a & 0xF) < (((v as uint) & 0xF) + carryIn);
    let c = a < subtrahend;
    let result = diff as uint8;
    CpuSetFlags(cpu, result == 0, true, h, c);
    if store {
        cpu.a = result;
    }
}

/// AND A,v。
func AluAnd(cpu: *var Cpu, v: uint8) {
    cpu.a = cpu.a & v;
    CpuSetFlags(cpu, cpu.a == 0, false, true, false);
}

/// OR A,v。
func AluOr(cpu: *var Cpu, v: uint8) {
    cpu.a = cpu.a | v;
    CpuSetFlags(cpu, cpu.a == 0, false, false, false);
}

/// XOR A,v。
func AluXor(cpu: *var Cpu, v: uint8) {
    cpu.a = cpu.a ^ v;
    CpuSetFlags(cpu, cpu.a == 0, false, false, false);
}

/// INC r8(Carryフラグは変化しない)。
func AluInc8(cpu: *var Cpu, v: uint8) -> uint8 {
    let result = v + 1;
    let h = (v & 0xF) + 1 > 0xF;
    CpuSetFlags(cpu, result == 0, false, h, CpuFlagC(cpu));
    return result;
}

/// DEC r8(Carryフラグは変化しない)。
func AluDec8(cpu: *var Cpu, v: uint8) -> uint8 {
    let result = v - 1;
    let h = (v & 0xF) == 0;
    CpuSetFlags(cpu, result == 0, true, h, CpuFlagC(cpu));
    return result;
}

/// DAA(直前のADD/SUB結果をBCDへ補正する)。
func CpuDaa(cpu: *var Cpu) {
    let n = CpuFlagN(cpu);
    let h = CpuFlagH(cpu);
    let c = CpuFlagC(cpu);
    var correction: uint8 = 0;
    var setC = c;

    if h || (!n && (cpu.a & 0x0F) > 0x09) {
        correction = correction | 0x06;
    }
    if c || (!n && cpu.a > 0x99) {
        correction = correction | 0x60;
        setC = true;
    }

    if n {
        cpu.a -= correction;
    } else {
        cpu.a += correction;
    }

    CpuSetFlags(cpu, cpu.a == 0, n, false, setC);
}

/// IF & IE の下位5bit(受理待ちの割り込み種別ビット)を返す。
func InterruptPending(bus: *Bus) -> uint8 {
    return (bus.io[0x0F] & 0x1F) & (bus.ie & 0x1F);
}

/// IME=1 かつ保留中の割り込みがあれば1件受理してベクタへジャンプする。
/// 受理した場合はtrueを返す(呼び出し側はこのステップの命令フェッチを行わない)。
func HandleInterrupts(cpu: *var Cpu, bus: *var Bus) -> bool {
    if !cpu.ime || InterruptPending(bus) == 0 {
        return false;
    }

    cpu.halted = false;
    cpu.imeDelay = 0;

    // 受理の最初の 2 M-cycle は内部サイクル。PC 上位バイトの PUSH が
    // IE を書き換え得るので、ベクタはその書き込み後の pending 状態から選ぶ。
    BusTick(bus, 4);
    BusTick(bus, 4);
    cpu.ime = false;

    let pc = cpu.pc;
    cpu.sp -= 1;
    CpuWrite8(cpu, bus, cpu.sp, (pc >> 8) as uint8);

    let pending = InterruptPending(bus);
    var vector: uint16 = 0;
    if (pending & 0x01) != 0 {
        vector = 0x40;
        bus.io[0x0F] = bus.io[0x0F] & ~0x01;
    } else if (pending & 0x02) != 0 {
        vector = 0x48;
        bus.io[0x0F] = bus.io[0x0F] & ~0x02;
    } else if (pending & 0x04) != 0 {
        vector = 0x50;
        bus.io[0x0F] = bus.io[0x0F] & ~0x04;
    } else if (pending & 0x08) != 0 {
        vector = 0x58;
        bus.io[0x0F] = bus.io[0x0F] & ~0x08;
    } else if (pending & 0x10) != 0 {
        vector = 0x60;
        bus.io[0x0F] = bus.io[0x0F] & ~0x10;
    }

    cpu.sp -= 1;
    CpuWrite8(cpu, bus, cpu.sp, pc as uint8);
    BusTick(bus, 4);
    cpu.pc = vector;
    return true;
}

/// 1命令を実行し、消費した T-cycle 数を返す。HALT/割り込み受理も含む。
pub func CpuStep(cpu: *var Cpu, bus: *var Bus) -> int {
    let start = bus.cycles;

    if cpu.halted {
        if InterruptPending(bus) != 0 {
            cpu.halted = false;
        } else {
            BusTick(bus, 4);
            return (bus.cycles - start) as int;
        }
    }

    if HandleInterrupts(cpu, bus) {
        return (bus.cycles - start) as int;
    }

    // EI の効果は「次の1命令」実行後まで遅延する。ここでの解決は
    // 上の割り込み受理チェック(この命令の直前)より後、命令フェッチより前に
    // 行うことで、EI 直後の命令は必ず割り込みなしで実行され、
    // その次の命令フェッチ時点で初めて IME=1 として扱われる。
    if cpu.imeDelay > 0 {
        cpu.imeDelay -= 1;
        if cpu.imeDelay == 0 {
            cpu.ime = true;
        }
    }

    let opcode = CpuRead8(cpu, bus, cpu.pc);
    if cpu.haltBug {
        cpu.haltBug = false;
    } else {
        cpu.pc += 1;
    }

    if cpu.debugBreakOnLdBb && opcode == 0x40 {
        cpu.ldBbHit = true;
    }

    CpuExecute(cpu, bus, opcode);

    return (bus.cycles - start) as int;
}

/// ALU演算グループ(op=0..7: ADD,ADC,SUB,SBC,AND,XOR,OR,CP)を1つ実行する。
func CpuAluOp(cpu: *var Cpu, op: uint8, v: uint8) {
    if op == 0 { AluAdd(cpu, v, 0); }
    else if op == 1 { AluAdd(cpu, v, CpuFlagC(cpu) ? 1u : 0u); }
    else if op == 2 { AluSub(cpu, v, 0, true); }
    else if op == 3 { AluSub(cpu, v, CpuFlagC(cpu) ? 1u : 0u, true); }
    else if op == 4 { AluAnd(cpu, v); }
    else if op == 5 { AluXor(cpu, v); }
    else if op == 6 { AluOr(cpu, v); }
    else { AluSub(cpu, v, 0, false); } // CP
}

/// CBプレフィックスの回転/シフトグループ(op=0..7: RLC,RRC,RL,RR,SLA,SRA,SWAP,SRL)。
func CbRotateShift(cpu: *var Cpu, op: uint8, v: uint8) -> uint8 {
    var result: uint8 = 0;
    var carryOut = false;

    if op == 0 { // RLC
        carryOut = (v & 0x80) != 0;
        result = (v << 1) | (carryOut ? 1u8 : 0u8);
    } else if op == 1 { // RRC
        carryOut = (v & 0x01) != 0;
        result = (v >> 1) | (carryOut ? 0x80u8 : 0u8);
    } else if op == 2 { // RL
        carryOut = (v & 0x80) != 0;
        result = (v << 1) | (CpuFlagC(cpu) ? 1u8 : 0u8);
    } else if op == 3 { // RR
        carryOut = (v & 0x01) != 0;
        result = (v >> 1) | (CpuFlagC(cpu) ? 0x80u8 : 0u8);
    } else if op == 4 { // SLA
        carryOut = (v & 0x80) != 0;
        result = v << 1;
    } else if op == 5 { // SRA
        carryOut = (v & 0x01) != 0;
        result = (v >> 1) | (v & 0x80);
    } else if op == 6 { // SWAP
        result = (v << 4) | (v >> 4);
        carryOut = false;
    } else { // SRL
        carryOut = (v & 0x01) != 0;
        result = v >> 1;
    }

    CpuSetFlags(cpu, result == 0, false, false, carryOut);
    return result;
}

/// CBプレフィックス命令(0xCB xx)を1命令実行する。
func CpuExecuteCb(cpu: *var Cpu, bus: *var Bus, opcode: uint8) {
    let group = opcode >> 6;
    let op = (opcode >> 3) & 7;
    let idx = opcode & 7;

    if group == 0 {
        let v = R8Get(cpu, bus, idx);
        R8Set(cpu, bus, idx, CbRotateShift(cpu, op, v));
    } else if group == 1 {
        let v = R8Get(cpu, bus, idx);
        let bit = (v & (1u8 << (op as uint))) != 0;
        cpu.f = (cpu.f & FlagC) | FlagH | (bit ? 0u8 : FlagZ);
    } else if group == 2 {
        let v = R8Get(cpu, bus, idx);
        R8Set(cpu, bus, idx, v & ~(1u8 << (op as uint)));
    } else {
        let v = R8Get(cpu, bus, idx);
        R8Set(cpu, bus, idx, v | (1u8 << (op as uint)));
    }
}

/// 非CBプレフィックスの1命令を実行する(オペコードは呼び出し側で読み取り済み)。
pub func CpuExecute(cpu: *var Cpu, bus: *var Bus, opcode: uint8) {
    if opcode == 0x00 {
        // NOP
    }
    // --- LD r,r'(実ゲームで最頻出の命令群のため先頭で判定する。落とし穴:
    // 0x76=HALTはこの範囲に含まれるが、制御系ブロックで個別に扱うため
    // ここでは除外する) ---
    else if opcode != 0x76 && opcode >= 0x40 && opcode <= 0x7F {
        let dst = (opcode >> 3) & 7;
        let src = opcode & 7;
        let v = R8Get(cpu, bus, src);
        R8Set(cpu, bus, dst, v);
    }
    // --- ALU A,r(同じく高頻度) ---
    else if opcode >= 0x80 && opcode <= 0xBF {
        let op = (opcode >> 3) & 7;
        let src = opcode & 7;
        let v = R8Get(cpu, bus, src);
        CpuAluOp(cpu, op, v);
    }
    // --- INC r / DEC r (8bit)(ループカウンタ等で高頻度のため先頭寄りへ) ---
    else if opcode == 0x04 || opcode == 0x0C || opcode == 0x14 || opcode == 0x1C ||
            opcode == 0x24 || opcode == 0x2C || opcode == 0x34 || opcode == 0x3C {
        let idx = (opcode >> 3) & 7;
        let v = R8Get(cpu, bus, idx);
        R8Set(cpu, bus, idx, AluInc8(cpu, v));
    } else if opcode == 0x05 || opcode == 0x0D || opcode == 0x15 || opcode == 0x1D ||
               opcode == 0x25 || opcode == 0x2D || opcode == 0x35 || opcode == 0x3D {
        let idx = (opcode >> 3) & 7;
        let v = R8Get(cpu, bus, idx);
        R8Set(cpu, bus, idx, AluDec8(cpu, v));
    }
    // --- JR(条件分岐、高頻度のため先頭寄りへ) ---
    else if opcode == 0x20 || opcode == 0x30 || opcode == 0x28 || opcode == 0x38 {
        let idx = (opcode >> 3) & 3;
        let e8 = ReadImm8(cpu, bus);
        if CcTest(cpu, idx) {
            if (e8 & 0x80) != 0 {
                let neg = (0x100 - (e8 as uint)) as uint16;
                cpu.pc -= neg;
            } else {
                cpu.pc += e8 as uint16;
            }
            BusTick(bus, 4);
        }
    } else if opcode == 0x18 {
        let e8 = ReadImm8(cpu, bus);
        if (e8 & 0x80) != 0 {
            let neg = (0x100 - (e8 as uint)) as uint16;
            cpu.pc -= neg;
        } else {
            cpu.pc += e8 as uint16;
        }
        BusTick(bus, 4);
    }
    // --- LD r,d8 ---
    else if opcode == 0x06 || opcode == 0x0E || opcode == 0x16 || opcode == 0x1E ||
            opcode == 0x26 || opcode == 0x2E || opcode == 0x3E {
        let dst = (opcode >> 3) & 7;
        let v = ReadImm8(cpu, bus);
        R8Set(cpu, bus, dst, v);
    } else if opcode == 0x36 {
        let v = ReadImm8(cpu, bus);
        CpuWrite8(cpu, bus, CpuHl(cpu), v);
    }
    // --- 16bit ロード ---
    else if opcode == 0x01 || opcode == 0x11 || opcode == 0x21 || opcode == 0x31 {
        let idx = (opcode >> 4) & 3;
        RpSet(cpu, idx, ReadImm16(cpu, bus));
    } else if opcode == 0x02 {
        CpuWrite8(cpu, bus, CpuBc(cpu), cpu.a);
    } else if opcode == 0x12 {
        CpuWrite8(cpu, bus, CpuDe(cpu), cpu.a);
    } else if opcode == 0x22 {
        let hl = CpuHl(cpu);
        CpuWrite8(cpu, bus, hl, cpu.a);
        CpuSetHl(cpu, hl + 1);
    } else if opcode == 0x32 {
        let hl = CpuHl(cpu);
        CpuWrite8(cpu, bus, hl, cpu.a);
        CpuSetHl(cpu, hl - 1);
    } else if opcode == 0x0A {
        cpu.a = CpuRead8(cpu, bus, CpuBc(cpu));
    } else if opcode == 0x1A {
        cpu.a = CpuRead8(cpu, bus, CpuDe(cpu));
    } else if opcode == 0x2A {
        let hl = CpuHl(cpu);
        cpu.a = CpuRead8(cpu, bus, hl);
        CpuSetHl(cpu, hl + 1);
    } else if opcode == 0x3A {
        let hl = CpuHl(cpu);
        cpu.a = CpuRead8(cpu, bus, hl);
        CpuSetHl(cpu, hl - 1);
    } else if opcode == 0x08 {
        let addr = ReadImm16(cpu, bus);
        CpuWrite8(cpu, bus, addr, cpu.sp as uint8);
        CpuWrite8(cpu, bus, addr + 1, (cpu.sp >> 8) as uint8);
    } else if opcode == 0xF9 {
        BusTick(bus, 4); // internal
        cpu.sp = CpuHl(cpu);
    }
    // --- 16bit INC/DEC (フラグ無影響、内部+4サイクル) ---
    else if opcode == 0x03 || opcode == 0x13 || opcode == 0x23 || opcode == 0x33 {
        let idx = (opcode >> 4) & 3;
        RpSet(cpu, idx, RpGet(cpu, idx) + 1);
        BusTick(bus, 4);
    } else if opcode == 0x0B || opcode == 0x1B || opcode == 0x2B || opcode == 0x3B {
        let idx = (opcode >> 4) & 3;
        RpSet(cpu, idx, RpGet(cpu, idx) - 1);
        BusTick(bus, 4);
    }
    // --- ADD HL,rr ---
    else if opcode == 0x09 || opcode == 0x19 || opcode == 0x29 || opcode == 0x39 {
        let idx = (opcode >> 4) & 3;
        let hl = CpuHl(cpu) as uint;
        let v = RpGet(cpu, idx) as uint;
        let sum = hl + v;
        let h = ((hl & 0xFFF) + (v & 0xFFF)) > 0xFFF;
        CpuSetFlags(cpu, CpuFlagZ(cpu), false, h, sum > 0xFFFF);
        CpuSetHl(cpu, sum as uint16);
        BusTick(bus, 4);
    }
    // --- ADD SP,e8 / LD HL,SP+e8 ---
    else if opcode == 0xE8 {
        let result = SpAddOffset(cpu, bus);
        BusTick(bus, 4);
        BusTick(bus, 4);
        cpu.sp = result;
    } else if opcode == 0xF8 {
        let result = SpAddOffset(cpu, bus);
        BusTick(bus, 4);
        CpuSetHl(cpu, result);
    }
    // --- PUSH/POP ---
    else if opcode == 0xC1 || opcode == 0xD1 || opcode == 0xE1 || opcode == 0xF1 {
        let idx = (opcode >> 4) & 3;
        Rp2Set(cpu, idx, Pop16(cpu, bus));
    } else if opcode == 0xC5 || opcode == 0xD5 || opcode == 0xE5 || opcode == 0xF5 {
        let idx = (opcode >> 4) & 3;
        BusTick(bus, 4); // internal
        Push16(cpu, bus, Rp2Get(cpu, idx));
    }
    // --- RET / RETI ---
    else if opcode == 0xC0 || opcode == 0xD0 || opcode == 0xC8 || opcode == 0xD8 {
        let idx = (opcode >> 3) & 3;
        BusTick(bus, 4); // 条件チェック用
        if CcTest(cpu, idx) {
            cpu.pc = Pop16(cpu, bus);
            BusTick(bus, 4);
        }
    } else if opcode == 0xC9 {
        cpu.pc = Pop16(cpu, bus);
        BusTick(bus, 4);
    } else if opcode == 0xD9 {
        cpu.pc = Pop16(cpu, bus);
        BusTick(bus, 4);
        cpu.ime = true;
    }
    // --- JP ---
    else if opcode == 0xC2 || opcode == 0xD2 || opcode == 0xCA || opcode == 0xDA {
        let idx = (opcode >> 3) & 3;
        let addr = ReadImm16(cpu, bus);
        if CcTest(cpu, idx) {
            cpu.pc = addr;
            BusTick(bus, 4);
        }
    } else if opcode == 0xC3 {
        let addr = ReadImm16(cpu, bus);
        cpu.pc = addr;
        BusTick(bus, 4);
    } else if opcode == 0xE9 {
        cpu.pc = CpuHl(cpu);
    }
    // --- CALL ---
    else if opcode == 0xC4 || opcode == 0xD4 || opcode == 0xCC || opcode == 0xDC {
        let idx = (opcode >> 3) & 3;
        let addr = ReadImm16(cpu, bus);
        if CcTest(cpu, idx) {
            BusTick(bus, 4); // internal
            Push16(cpu, bus, cpu.pc);
            cpu.pc = addr;
        }
    } else if opcode == 0xCD {
        let addr = ReadImm16(cpu, bus);
        BusTick(bus, 4); // internal
        Push16(cpu, bus, cpu.pc);
        cpu.pc = addr;
    }
    // --- RST ---
    else if opcode == 0xC7 || opcode == 0xCF || opcode == 0xD7 || opcode == 0xDF ||
            opcode == 0xE7 || opcode == 0xEF || opcode == 0xF7 || opcode == 0xFF {
        let vector = (opcode & 0x38) as uint16;
        BusTick(bus, 4); // internal
        Push16(cpu, bus, cpu.pc);
        cpu.pc = vector;
    }
    // --- LDH / (C) / (a16) ---
    else if opcode == 0xE0 {
        let addr = 0xFF00u16 + ReadImm8(cpu, bus) as uint16;
        CpuWrite8(cpu, bus, addr, cpu.a);
    } else if opcode == 0xF0 {
        let addr = 0xFF00u16 + ReadImm8(cpu, bus) as uint16;
        cpu.a = CpuRead8(cpu, bus, addr);
    } else if opcode == 0xE2 {
        CpuWrite8(cpu, bus, 0xFF00u16 + cpu.c as uint16, cpu.a);
    } else if opcode == 0xF2 {
        cpu.a = CpuRead8(cpu, bus, 0xFF00u16 + cpu.c as uint16);
    } else if opcode == 0xEA {
        let addr = ReadImm16(cpu, bus);
        CpuWrite8(cpu, bus, addr, cpu.a);
    } else if opcode == 0xFA {
        let addr = ReadImm16(cpu, bus);
        cpu.a = CpuRead8(cpu, bus, addr);
    }
    // --- CB Prefix ---
    else if opcode == 0xCB {
        let cbOpcode = CpuRead8(cpu, bus, cpu.pc);
        cpu.pc += 1;
        CpuExecuteCb(cpu, bus, cbOpcode);
    }
    // --- 制御系 ---
    else if opcode == 0x76 {
        // HALT
        if cpu.imeDelay > 0 {
            cpu.ime = true;
            cpu.imeDelay = 0;
        }
        if !cpu.ime && InterruptPending(bus) != 0 {
            cpu.haltBug = true;
        } else {
            cpu.halted = true;
        }
    } else if opcode == 0x10 {
        // STOP: 2バイト命令(パディングバイトを読み飛ばす)。
        // T6-6: CGBモードでKEY1切替準備(speedSwitchPrepared)済みならここで速度を
        // 反転する。DMGモード、またはCGBでも準備されていなければ何もしない。
        cpu.pc += 1;
        if bus.mode == GbMode::Cgb && bus.speedSwitchPrepared {
            bus.doubleSpeed = !bus.doubleSpeed;
            bus.speedSwitchPrepared = false;
            TimerWriteDiv(bus); // DIVリセット(実機の仕様、Pan Docs "CGB Registers: KEY1")
        }
    } else if opcode == 0xF3 {
        cpu.ime = false;
        cpu.imeDelay = 0;
    } else if opcode == 0xFB {
        cpu.imeDelay = 1;
    }
    // --- アキュムレータ回転 (非CB版は常に Z=0) ---
    else if opcode == 0x07 { // RLCA
        cpu.a = CbRotateShift(cpu, 0, cpu.a);
        cpu.f = cpu.f & ~FlagZ;
    } else if opcode == 0x0F { // RRCA
        cpu.a = CbRotateShift(cpu, 1, cpu.a);
        cpu.f = cpu.f & ~FlagZ;
    } else if opcode == 0x17 { // RLA
        cpu.a = CbRotateShift(cpu, 2, cpu.a);
        cpu.f = cpu.f & ~FlagZ;
    } else if opcode == 0x1F { // RRA
        cpu.a = CbRotateShift(cpu, 3, cpu.a);
        cpu.f = cpu.f & ~FlagZ;
    }
    // --- DAA・フラグ操作系 ---
    else if opcode == 0x27 {
        CpuDaa(cpu);
    } else if opcode == 0x2F { // CPL
        cpu.a = ~cpu.a;
        cpu.f = (cpu.f & (FlagZ | FlagC)) | FlagN | FlagH;
    } else if opcode == 0x37 { // SCF
        cpu.f = (cpu.f & FlagZ) | FlagC;
    } else if opcode == 0x3F { // CCF
        let newC = CpuFlagC(cpu) ? 0u8 : FlagC;
        cpu.f = (cpu.f & FlagZ) | newC;
    }
    // --- 未定義オペコード ---
    else if opcode == 0xD3 || opcode == 0xDB || opcode == 0xDD || opcode == 0xE3 ||
            opcode == 0xE4 || opcode == 0xEB || opcode == 0xEC || opcode == 0xED ||
            opcode == 0xF4 || opcode == 0xFC || opcode == 0xFD {
        CpuLogIllegal(cpu, opcode);
    }
    // --- ALU A,d8 ---
    else if opcode == 0xC6 || opcode == 0xCE || opcode == 0xD6 || opcode == 0xDE ||
               opcode == 0xE6 || opcode == 0xEE || opcode == 0xF6 || opcode == 0xFE {
        let op = (opcode >> 3) & 7;
        let v = ReadImm8(cpu, bus);
        CpuAluOp(cpu, op, v);
    } else {
        CpuLogIllegal(cpu, opcode);
    }
}
