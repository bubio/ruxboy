/// メモリマップと M-cycle tick 駆動。CPU の全メモリアクセスがここを通る。

import Core::Slice;

/// OAM のバイト数。
pub const OamSize: uint = 160;
/// VRAM 1バンクあたりのバイト数。
pub const VramBankSize: uint = 8192;
/// WRAM 1バンクあたりのバイト数。
pub const WramBankSize: uint = 4096;
/// HRAM のバイト数。
pub const HramSize: uint = 127;
/// I/O レジスタ領域のバイト数(FF00-FF7F)。
pub const IoSize: uint = 128;
/// CGB パレットRAM(BG/OBJ各)のバイト数(8パレット×4色×2バイト)。
pub const PaletteRamSize: uint = 64;

/// シリアル出力ログの最大バイト数(Blargg 系テストROMの結果文字列用)。
pub const SerialLogCapacity: uint = 16384;

/// メモリマップ全体と周辺デバイス(Timer/PPU/OAM DMA/Serial)の状態。
pub struct Bus {
    pub mode: GbMode;
    pub cart: Cartridge;
    // 2バンクを1次元配列にフラット化(bank*VramBankSize+offset)。
    // バンク0=DMG互換、バンク1=CGB属性/追加タイルデータ。
    pub vram: uint8[16384];
    pub vramBank: uint8; // VBK(FF4F) bit0。DMGモードでは常に0固定(書き込み無視)
    // 8バンクを1次元配列にフラット化(bank*WramBankSize+offset)。
    // C000-CFFFはバンク0固定、D000-DFFFはwramBankが選ぶ。
    pub wram: uint8[32768];
    pub wramBank: uint8; // SVBK生値(0-7)。「0→1読み替え」はWramActiveBankで解決する
    pub oam: uint8[160];
    pub hram: uint8[127];
    pub io: uint8[128];
    pub ie: uint8;
    pub cycles: uint64;
    pub hwCycles: uint64;
    pub doubleSpeed: bool;
    pub speedSwitchPrepared: bool;

    // CGB パレットRAM(FF68-FF6B)
    pub bgPaletteRam: uint8[64];
    pub objPaletteRam: uint8[64];
    pub bcps: uint8;
    pub ocps: uint8;

    // CGB HDMA/GDMA(FF51-FF55)
    pub hdmaSource: uint16;
    pub hdmaDestination: uint16;
    pub hdmaRemaining: int;
    pub hdmaActive: bool;
    pub hdmaAborted: bool;
    pub hdmaAbortedRemaining: int;

    // Timer
    pub divCounter: uint16;
    pub tima: uint8;
    pub tma: uint8;
    pub tac: uint8;
    pub timerReloadPending: int;
    pub timerReloadJustHappened: bool;

    // Serial (Phase 1 T1-7)
    pub serialLog: uint8[16384];
    pub serialLogLength: uint;

    // PPU
    pub ppu: Ppu;

    // APU
    pub apu: Apu;

    // OAM DMA (FF46)
    pub dmaActive: bool;
    pub dmaSource: uint16;
    pub dmaIndex: int;
    pub dmaStartDelay: int;
    pub dmaPendingSource: uint16;

    // Joypad (FF00)
    /// JOYP bit5=0で選択(アクションボタン: A/B/Select/Start)。
    pub joypSelectAction: bool;
    /// JOYP bit4=0で選択(方向キー: Right/Left/Up/Down)。
    pub joypSelectDirection: bool;
    /// 押下中のボタンのビットマスク(`JoypadButtonBit`参照)。
    pub joypPressed: uint8;
}

/// Bus を初期状態にする(全レジスタ0、ROM未ロード)。実 BIOS 相当の初期値は
/// `BusPowerOn` で別途セットする。
pub func BusInit(bus: *var Bus) {
    bus.mode = GbMode::Dmg;
    CartridgeReset(@bus.cart);
    bus.ie = 0;
    bus.cycles = 0;
    bus.hwCycles = 0;
    bus.doubleSpeed = false;
    bus.speedSwitchPrepared = false;
    bus.vramBank = 0;
    bus.wramBank = 0;
    bus.bcps = 0;
    bus.ocps = 0;
    bus.hdmaSource = 0;
    bus.hdmaDestination = 0;
    bus.hdmaRemaining = 0;
    bus.hdmaActive = false;
    bus.hdmaAborted = false;
    bus.hdmaAbortedRemaining = 0;
    bus.divCounter = 0;
    bus.tima = 0;
    bus.tma = 0;
    bus.tac = 0;
    bus.timerReloadPending = 0;
    bus.timerReloadJustHappened = false;
    bus.serialLogLength = 0;
    bus.dmaActive = false;
    bus.dmaSource = 0;
    bus.dmaIndex = 0;
    bus.dmaStartDelay = 0;
    bus.dmaPendingSource = 0;
    bus.joypSelectAction = false;
    bus.joypSelectDirection = false;
    bus.joypPressed = 0;
    ApuReset(@bus.apu);

    var i: uint = 0;
    while i < IoSize {
        bus.io[i] = 0;
        i += 1;
    }
}

/// ROM データを解析し、カートリッジ(ヘッダ情報 + MBC 初期状態)をロードする。
/// data は借用のまま `bus.cart.rom` に保持される(コピーしない)。ヘッダ不正・
/// 未対応種別・サイズ不足は失敗する。
pub func BusLoadRom(bus: *var Bus, data: Slice<uint8>) -> bool {
    let err = CartridgeInit(@bus.cart, data);
    if err != CartridgeParseError::None {
        return false;
    }
    bus.mode = GbModeFromCgbFlag(bus.cart.info.cgbFlag);
    return true;
}

/// ブート ROM 完了直後の IO レジスタ状態を直接セットする(実 BIOS ROM は読み
/// 込まない方針のため)。現時点では PPU レジスタのみ。
pub func BusPowerOn(bus: *var Bus) {
    PpuPowerOn(@bus.ppu);
    ApuPowerOn(@bus.apu);
}

/// t_cycles ぶん時間を進める。CPU の全メモリアクセスごとに呼ばれ、
/// Timer/PPU/OAM DMA を駆動する唯一の場所。
pub func BusTick(bus: *var Bus, tCycles: int) {
    let cyclesU = tCycles as uint64;
    bus.cycles += cyclesU;

    // T6-6: ダブルスピード中、CPU/Timer/シリアルは2倍速、PPU/APUは等速で進む
    // (「CPUの1 M-cycleにつき、PPU/APUへは2 T-cycleだけ供給」する方式)。
    // 逆にするとTimerの音程が半オクターブずれたりゲームが倍速になったりする
    // 落とし穴があるため、Timer/OAM DMAはCPU側のtCyclesのまま進める。
    var hwCycles = tCycles;
    if bus.doubleSpeed {
        hwCycles = tCycles / 2;
    }
    bus.hwCycles += hwCycles as uint64;

    TimerTick(bus, tCycles);
    PpuTick(bus, hwCycles);
    ApuTick(@bus.apu, hwCycles);

    var mCycles = tCycles / 4;
    while mCycles > 0 {
        DmaTickOneMcycle(bus);
        mCycles -= 1;
    }
}

/// OAM DMA を1 M-cycleぶん進める。
/// 開始タイミング: M0でFF46書き込み(dma_start_delay=2をセットするのみ)、M1では
/// まだ何も起きない、M2で新しい転送が開始し以後1バイト/M-cycleで160 M-cycleかけて
/// 転送する。
func DmaTickOneMcycle(bus: *var Bus) {
    if bus.dmaStartDelay > 0 {
        bus.dmaStartDelay -= 1;
        if bus.dmaStartDelay == 0 {
            bus.dmaActive = true;
            bus.dmaSource = bus.dmaPendingSource;
            bus.dmaIndex = 0;
        }
    }

    if bus.dmaActive {
        bus.oam[bus.dmaIndex as uint] = BusReadRaw(bus, bus.dmaSource + (bus.dmaIndex as uint16));
        bus.dmaIndex += 1;
        if (bus.dmaIndex as uint) >= OamSize {
            bus.dmaActive = false;
        }
    }
}

/// TAC の下位2bitから、DIV(16bit divider)のどのビットの立ち下がりで
/// TIMA が増分するかを返す。
func TimerSelectedBit(tac: uint8) -> uint {
    let speed = tac & 0x03;
    if speed == 0 { return 9; }
    else if speed == 1 { return 3; }
    else if speed == 2 { return 5; }
    return 7;
}

/// タイマーが有効(TAC bit2=1)なときの、選択ビットの現在値(falling-edge検出用)。
func TimerSignal(divider: uint16, tac: uint8) -> bool {
    if (tac & 0x04) == 0 { return false; }
    return (divider & ((1 as uint16) << TimerSelectedBit(tac))) != 0;
}

/// TIMA を1増やす。オーバーフロー(0xFF→0x00)した場合は4 T-cycle後の
/// TMA リロードを予約する(即座にはリロードしない、実機の遅延を再現)。
func TimerIncrementTima(bus: *var Bus) {
    if bus.timerReloadPending > 0 { return; }
    if bus.tima == 0xFF {
        bus.tima = 0;
        bus.timerReloadPending = 4;
    } else {
        bus.tima += 1;
    }
}

/// 予約済みの TMA リロードを1 T-cycleぶん進める。0に達したら TIMA=TMA とし、
/// タイマー割り込み(IF bit2)を要求する。
func TimerAdvanceReload(bus: *var Bus) {
    if bus.timerReloadPending <= 0 { return; }
    if bus.timerReloadPending == 1 {
        bus.timerReloadPending = 0;
        bus.tima = bus.tma;
        bus.timerReloadJustHappened = true;
        bus.io[0x0F] = bus.io[0x0F] | 0x04;
    } else {
        bus.timerReloadPending -= 1;
    }
}

/// DIV/TIMA を tCycles ぶん、1 T-cycleずつ進める(falling-edge検出の
/// 取りこぼしを防ぐため、まとめて計算せず逐次進める)。
///
/// 落とし穴(性能): CPU全メモリアクセスごとに呼ばれる最も熱いパスであり、Rux
/// Releaseパイプラインは関数インライン化を行わない(external/Rux/Docs/
/// Architecture.mdに列挙されたRelease最適化は定数畳み込み/コピー伝播/DCE/
/// CFG整理のみ)。TimerAdvanceReload/TimerSignal/TimerSelectedBit/
/// TimerIncrementTima を1 T-cycleごとに呼んでいた実装から、このループ本体へ
/// 手動でインライン化した(bus.tac はこの関数の実行中に変化しないため
/// selectedBit/enabled もループ外で1回だけ計算する)。Apu.rux の ApuTick と
/// 同じ対策(phase-05-apu.md参照)。
func TimerTick(bus: *var Bus, tCycles: int) {
    let tac = bus.tac;
    let enabled = (tac & 0x04) != 0;
    var selectedBit: uint = 7;
    let speed = tac & 0x03;
    if speed == 0 { selectedBit = 9; }
    else if speed == 1 { selectedBit = 3; }
    else if speed == 2 { selectedBit = 5; }
    let mask: uint16 = (1 as uint16) << selectedBit;

    var divider = bus.divCounter;
    var reloadPending = bus.timerReloadPending;
    var tima = bus.tima;
    let tma = bus.tma;
    var ifReg = bus.io[0x0F];
    var reloadJustHappened = false;

    var cycle: int = 0;
    while cycle < tCycles {
        // TimerAdvanceReload をインライン化
        if reloadPending > 0 {
            if reloadPending == 1 {
                reloadPending = 0;
                tima = tma;
                reloadJustHappened = true;
                ifReg = ifReg | 0x04;
            } else {
                reloadPending -= 1;
            }
        }

        // TimerSignal をインライン化(enabled/mask はループ外で計算済み)
        let oldSignal = enabled && (divider & mask) != 0;
        divider += 1;
        let newSignal = enabled && (divider & mask) != 0;
        if oldSignal && !newSignal {
            // TimerIncrementTima をインライン化
            if reloadPending <= 0 {
                if tima == 0xFF {
                    tima = 0;
                    reloadPending = 4;
                } else {
                    tima += 1;
                }
            }
        }
        cycle += 1;
    }

    bus.divCounter = divider;
    bus.timerReloadPending = reloadPending;
    bus.tima = tima;
    bus.io[0x0F] = ifReg;
    bus.timerReloadJustHappened = reloadJustHappened;
}

/// VRAM の任意バンクを直接読む(HDMA のソース読み取り用。CPU バス経由ではないため
/// dmaActive 等の制限を受けない)。
func VramReadBank(bus: *Bus, bank: uint8, addr: uint16) -> uint8 {
    let b = (bank & 0x01) as uint;
    return bus.vram[b * VramBankSize + (addr - 0x8000) as uint];
}

/// SVBK の「0指定は1扱い」を解決した、D000-DFFF(およびそのエコー)が実際に使う
/// バンク番号(1-7)を返す。BusPowerOn を呼ばない生の Bus(テストで多用)でも
/// 常に正しく動くよう、書き込み時ではなくここで解決する。
func WramActiveBank(bus: *Bus) -> uint8 {
    let b = bus.wramBank & 0x07;
    if b == 0 { return 1; }
    return b;
}

/// CPU アドレス(C000-DFFF、または E000-FDFFのエコー)を実バンク番号とバンク内
/// オフセットへ変換する。エコーRAMはC000-DDFFだけをミラーする。
func WramLocate(bus: *Bus, addr: uint16, bank: *var uint8, offset: *var uint16) {
    var a = addr;
    if a >= 0xE000 { a -= 0x2000; }
    if a <= 0xCFFF {
        *bank = 0;
        *offset = a - 0xC000;
        return;
    }
    *bank = WramActiveBank(bus);
    *offset = a - 0xD000;
}

/// CPU からの読み出し。OAM DMA 中は OAM 領域(FE00-FE9F)読み出しが 0xFF に
/// 化ける(DMA自身の内部読み出しはこの制限を受けない `BusReadRaw` を直接使う)。
pub func BusRead(bus: *Bus, addr: uint16) -> uint8 {
    if bus.dmaActive && addr >= 0xFE00 && addr <= 0xFE9F {
        return 0xFF;
    }
    return BusReadRaw(bus, addr);
}

/// OAM DMA によるバス競合を受けない生の読み出し。メモリマップ全域を解決する。
pub func BusReadRaw(bus: *Bus, addr: uint16) -> uint8 {
    if addr <= 0x7FFF {
        return MbcRead(@bus.cart, addr);
    } else if addr <= 0x9FFF {
        return VramReadBank(bus, bus.vramBank, addr);
    } else if addr <= 0xBFFF {
        return MbcRead(@bus.cart, addr);
    } else if addr <= 0xFDFF {
        var bank: uint8 = 0;
        var offset: uint16 = 0;
        WramLocate(bus, addr, @bank, @offset);
        return bus.wram[(bank as uint) * WramBankSize + (offset as uint)];
    } else if addr <= 0xFE9F {
        return bus.oam[(addr - 0xFE00) as uint];
    } else if addr <= 0xFEFF {
        return 0xFF; // 未使用領域
    } else if addr <= 0xFF7F {
        return BusIoRead(bus, addr);
    } else if addr <= 0xFFFE {
        return bus.hram[(addr - 0xFF80) as uint];
    } else {
        return bus.ie; // 0xFFFF
    }
}

/// CPU からの書き込み。OAM DMA 中は OAM 領域(FE00-FE9F)自身への書き込み
/// だけを無視する。
pub func BusWrite(bus: *var Bus, addr: uint16, value: uint8) {
    if bus.dmaActive && addr >= 0xFE00 && addr <= 0xFE9F {
        return;
    }
    if addr <= 0x7FFF {
        MbcWrite(@bus.cart, addr, value); // ROM領域: MBCのバンク切替レジスタ
    } else if addr <= 0x9FFF {
        let b = (bus.vramBank & 0x01) as uint;
        bus.vram[b * VramBankSize + (addr - 0x8000) as uint] = value;
    } else if addr <= 0xBFFF {
        MbcWrite(@bus.cart, addr, value);
    } else if addr <= 0xFDFF {
        var bank: uint8 = 0;
        var offset: uint16 = 0;
        WramLocate(bus, addr, @bank, @offset);
        bus.wram[(bank as uint) * WramBankSize + (offset as uint)] = value;
    } else if addr <= 0xFE9F {
        bus.oam[(addr - 0xFE00) as uint] = value;
    } else if addr <= 0xFEFF {
        // 未使用
    } else if addr <= 0xFF7F {
        BusIoWrite(bus, addr, value);
    } else if addr <= 0xFFFE {
        bus.hram[(addr - 0xFF80) as uint] = value;
    } else {
        bus.ie = value; // 0xFFFF
    }
}

// --- Joypad (FF00) ---
// 参照: ~/dev/_Emu/BubiBoyLite/src/core/joypad.odin。
// JOYP は負論理: 0=選択/押下、1=非選択/非押下。bit5=0でアクション(A/B/Select/Start)を
// bit3-0に反映、bit4=0で方向キー(Right/Left/Up/Down)をbit3-0に反映。両方選択時は
// 両グループのANDが出力される。上位2bitは常に1で読める。

pub const JoypadRight: uint8 = 0;
pub const JoypadLeft: uint8 = 1;
pub const JoypadUp: uint8 = 2;
pub const JoypadDown: uint8 = 3;
pub const JoypadA: uint8 = 4;
pub const JoypadB: uint8 = 5;
pub const JoypadSelect: uint8 = 6;
pub const JoypadStart: uint8 = 7;

func JoypadButtonBit(button: uint8) -> uint8 {
    return (1 as uint8) << button;
}

func JoypadButtonGroupSelected(bus: *Bus, button: uint8) -> bool {
    if button == JoypadA || button == JoypadB || button == JoypadSelect || button == JoypadStart {
        return bus.joypSelectAction;
    }
    return bus.joypSelectDirection;
}

/// ボタンの押下状態を更新する。選択中のグループのボタンが0(非押下)→1(押下)に
/// 変化したときジョイパッド割り込み(IF bit4)を要求する。
pub func JoypadSetButton(bus: *var Bus, button: uint8, pressed: bool) {
    let bit = JoypadButtonBit(button);
    let wasPressed = (bus.joypPressed & bit) != 0;

    if pressed {
        bus.joypPressed = bus.joypPressed | bit;
    } else {
        bus.joypPressed = bus.joypPressed & ~bit;
    }

    if pressed && !wasPressed && JoypadButtonGroupSelected(bus, button) {
        bus.io[0x0F] = bus.io[0x0F] | 0x10;
    }
}

/// JOYP(FF00)への書き込みを処理する: bit5/bit4だけが意味を持つ(0=選択)。
/// bit3-0への書き込みは無視される(読み取り専用)。
func JoypadWriteP1(bus: *var Bus, value: uint8) {
    bus.joypSelectAction = (value & 0x20) == 0;
    bus.joypSelectDirection = (value & 0x10) == 0;
}

/// JOYPの現在値を負論理エンコーディングで返す。
func JoypadReadP1(bus: *Bus) -> uint8 {
    var selectBits: uint8 = 0xC0; // 上位2bitは常に1
    if !bus.joypSelectAction { selectBits = selectBits | 0x20; }
    if !bus.joypSelectDirection { selectBits = selectBits | 0x10; }

    var actionBits: uint8 = 0x0F;
    if bus.joypSelectAction {
        if (bus.joypPressed & JoypadButtonBit(JoypadA)) != 0 { actionBits = actionBits & ~(0x01 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadB)) != 0 { actionBits = actionBits & ~(0x02 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadSelect)) != 0 { actionBits = actionBits & ~(0x04 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadStart)) != 0 { actionBits = actionBits & ~(0x08 as uint8); }
    }

    var directionBits: uint8 = 0x0F;
    if bus.joypSelectDirection {
        if (bus.joypPressed & JoypadButtonBit(JoypadRight)) != 0 { directionBits = directionBits & ~(0x01 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadLeft)) != 0 { directionBits = directionBits & ~(0x02 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadUp)) != 0 { directionBits = directionBits & ~(0x04 as uint8); }
        if (bus.joypPressed & JoypadButtonBit(JoypadDown)) != 0 { directionBits = directionBits & ~(0x08 as uint8); }
    }

    return selectBits | (actionBits & directionBits);
}

/// I/O レジスタ領域(FF00-FF7F)の読み出しをレジスタごとに振り分ける。
func BusIoRead(bus: *Bus, addr: uint16) -> uint8 {
    if addr == 0xFF00 {
        return JoypadReadP1(bus);
    } else if addr == 0xFF04 {
        return (bus.divCounter >> 8) as uint8;
    } else if addr == 0xFF05 {
        return bus.tima;
    } else if addr == 0xFF06 {
        return bus.tma;
    } else if addr == 0xFF07 {
        return bus.tac | 0xF8;
    } else if addr == 0xFF0F {
        return bus.io[0x0F] | 0xE0;
    } else if addr == 0xFF01 || addr == 0xFF02 || addr == 0xFF46 {
        return bus.io[(addr - 0xFF00) as uint];
    } else if (addr >= 0xFF40 && addr <= 0xFF45) || (addr >= 0xFF47 && addr <= 0xFF4B) {
        // FF46 (OAM DMA) は PPU レジスタではないため対象外
        return PpuRead(bus, addr);
    } else if (addr >= 0xFF10 && addr <= 0xFF26) || (addr >= 0xFF30 && addr <= 0xFF3F) {
        return ApuReadRegister(@bus.apu, addr);
    } else if addr == 0xFF4D {
        // KEY1。CGB専用。bit7=現在の速度(読み専用)、bit0=切替準備(読み書き可)、
        // 残りは常に1で読める未使用bit。
        if bus.mode != GbMode::Cgb { return 0xFF; }
        var v: uint8 = 0x7E;
        if bus.doubleSpeed { v = v | 0x80; }
        if bus.speedSwitchPrepared { v = v | 0x01; }
        return v;
    } else if addr == 0xFF4F {
        // VBK。CGB専用。DMGモードでは他の未実装レジスタと同じく0xFFを返す。
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return 0xFE | bus.vramBank;
    } else if addr >= 0xFF51 && addr <= 0xFF54 {
        // HDMA1-4は書き込み専用として扱う(読み出しは他の未実装レジスタと同じ0xFF)。
        return 0xFF;
    } else if addr == 0xFF55 {
        if bus.mode != GbMode::Cgb { return 0xFF; }
        if bus.hdmaActive {
            // 落とし穴: bit7は「非アクティブ」を表すので進行中は0のまま、
            // 下位7bitに残りブロック-1。
            return (bus.hdmaRemaining - 1) as uint8;
        }
        if bus.hdmaAborted {
            return ((bus.hdmaAbortedRemaining - 1) as uint8) | 0x80;
        }
        return 0xFF; // 非アクティブ(GDMA完了後・未使用時)
    } else if addr == 0xFF68 {
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return bus.bcps;
    } else if addr == 0xFF69 {
        // 落とし穴: 読み出しではオートインクリメントしない(書き込み時のみ)。
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return bus.bgPaletteRam[(bus.bcps & 0x3F) as uint];
    } else if addr == 0xFF6A {
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return bus.ocps;
    } else if addr == 0xFF6B {
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return bus.objPaletteRam[(bus.ocps & 0x3F) as uint];
    } else if addr == 0xFF70 {
        if bus.mode != GbMode::Cgb { return 0xFF; }
        return 0xF8 | WramActiveBank(bus); // 0指定は1扱いなので読み出しも解決済みバンクを返す
    }
    return 0xFF;
}

/// BCPS/OCPSのオートインクリメントを適用した新しいインデックスレジスタ値を返す。
/// bit7(オートインクリメント有効)が0なら何もしない。bit6は常に1で読める未使用bit
/// として保持し、インデックス(bit5-0)だけ+1(64でラップ)する。
func PaletteIndexIncrement(indexReg: uint8) -> uint8 {
    if (indexReg & 0x80) == 0 { return indexReg; }
    return (indexReg & 0x80) | 0x40 | ((indexReg + 1) & 0x3F);
}

/// DIV(FF04)書き込みの共通処理(DIVリセット)。CGBのSTOPによるダブルスピード
/// 切替後のDIVリセットからも呼ばれる(Pan Docs "CGB Registers: KEY1")。
pub func TimerWriteDiv(bus: *var Bus) {
    let oldSignal = TimerSignal(bus.divCounter, bus.tac);
    ApuNotifyDivWrite(@bus.apu, bus.divCounter); // divCounterをリセットする前(旧値を見る)に呼ぶ
    bus.divCounter = 0;
    if oldSignal {
        TimerIncrementTima(bus);
    }
}

/// I/O レジスタ領域(FF00-FF7F)の書き込みをレジスタごとに振り分ける。
func BusIoWrite(bus: *var Bus, addr: uint16, value: uint8) {
    if addr == 0xFF00 {
        JoypadWriteP1(bus, value);
    } else if addr == 0xFF04 {
        TimerWriteDiv(bus);
    } else if addr == 0xFF05 {
        if !bus.timerReloadJustHappened {
            bus.timerReloadPending = 0;
            bus.tima = value;
        }
    } else if addr == 0xFF06 {
        bus.tma = value;
        if bus.timerReloadJustHappened {
            bus.tima = value;
        }
    } else if addr == 0xFF07 {
        let oldSignal = TimerSignal(bus.divCounter, bus.tac);
        bus.tac = value & 0x07;
        let newSignal = TimerSignal(bus.divCounter, bus.tac);
        if oldSignal && !newSignal {
            TimerIncrementTima(bus);
        }
    } else if addr == 0xFF0F {
        bus.io[0x0F] = value & 0x1F;
    } else if addr == 0xFF01 {
        bus.io[0x01] = value;
    } else if addr == 0xFF02 {
        SerialWrite(bus, addr, value);
    } else if addr == 0xFF46 {
        bus.io[0x46] = value; // 読み戻し用(mooneye oam_dma/reg_read)
        bus.dmaPendingSource = (value as uint16) << 8;
        bus.dmaStartDelay = 2; // 1 M-cycleの遅延後、2M-cycle目から新しい転送が始まる
    } else if (addr >= 0xFF40 && addr <= 0xFF45) || (addr >= 0xFF47 && addr <= 0xFF4B) {
        PpuWrite(bus, addr, value);
    } else if (addr >= 0xFF10 && addr <= 0xFF26) || (addr >= 0xFF30 && addr <= 0xFF3F) {
        ApuWriteRegister(@bus.apu, addr, value);
    } else if addr == 0xFF4D {
        // bit0(切替準備)のみ書き込み可能。実際の速度反転はSTOP実行時(Cpu.rux)に行う。
        if bus.mode == GbMode::Cgb {
            bus.speedSwitchPrepared = (value & 0x01) != 0;
        }
    } else if addr == 0xFF4F {
        // 落とし穴: DMGモードではVBK書き込みを無視しバンク0固定のままにする。
        if bus.mode == GbMode::Cgb {
            bus.vramBank = value & 0x01;
        }
    } else if addr == 0xFF51 {
        if bus.mode == GbMode::Cgb {
            bus.hdmaSource = ((value as uint16) << 8) | (bus.hdmaSource & 0x00F0);
        }
    } else if addr == 0xFF52 {
        // 落とし穴: 下位4bitは無視(常に0)。
        if bus.mode == GbMode::Cgb {
            bus.hdmaSource = (bus.hdmaSource & 0xFF00) | ((value & 0xF0) as uint16);
        }
    } else if addr == 0xFF53 {
        // 落とし穴: 上位3bitはマスクされ常に0x8000起点(VRAM内)になる。
        if bus.mode == GbMode::Cgb {
            bus.hdmaDestination = 0x8000 | (((value & 0x1F) as uint16) << 8) | (bus.hdmaDestination & 0x00F0);
        }
    } else if addr == 0xFF54 {
        // 落とし穴: 下位4bitは無視(常に0)。
        if bus.mode == GbMode::Cgb {
            bus.hdmaDestination = 0x8000 | (bus.hdmaDestination & 0x1F00) | ((value & 0xF0) as uint16);
        }
    } else if addr == 0xFF55 {
        if bus.mode == GbMode::Cgb {
            HdmaStartOrCancel(bus, value);
        }
    } else if addr == 0xFF68 {
        if bus.mode == GbMode::Cgb {
            bus.bcps = value | 0x40; // bit6は常に1で読める
        }
    } else if addr == 0xFF69 {
        if bus.mode == GbMode::Cgb {
            bus.bgPaletteRam[(bus.bcps & 0x3F) as uint] = value;
            bus.bcps = PaletteIndexIncrement(bus.bcps); // 落とし穴: 書き込み時のみオートインクリメント
        }
    } else if addr == 0xFF6A {
        if bus.mode == GbMode::Cgb {
            bus.ocps = value | 0x40;
        }
    } else if addr == 0xFF6B {
        if bus.mode == GbMode::Cgb {
            bus.objPaletteRam[(bus.ocps & 0x3F) as uint] = value;
            bus.ocps = PaletteIndexIncrement(bus.ocps);
        }
    } else if addr == 0xFF70 {
        // 落とし穴: DMGモードではSVBK書き込みを無視する。
        if bus.mode == GbMode::Cgb {
            bus.wramBank = value & 0x07; // 0→1読み替えは読み出し/アドレス解決側(WramActiveBank)で行う
        }
    } else {
        bus.io[(addr - 0xFF00) as uint] = value;
    }
}

// --- CGB HDMA / GDMA ---

/// 現在の hdmaSource/hdmaDestination から16バイトをVRAM(現在のVBKバンク)へコピーする。
/// 宛先は0x8000起点のVRAM境界を超えず折り返す。
func HdmaCopyBlock(bus: *var Bus) {
    let destBase = (bus.hdmaDestination - 0x8000) as uint;
    let b = (bus.vramBank & 0x01) as uint;
    var offset: uint = 0;
    while offset < 16 {
        let value = BusReadRaw(bus, bus.hdmaSource + (offset as uint16));
        bus.vram[b * VramBankSize + destBase + offset] = value;
        offset += 1;
    }
    bus.hdmaSource += 0x10;
    bus.hdmaDestination = 0x8000 | ((bus.hdmaDestination + 0x10 - 0x8000) & 0x1FF0);
}

/// GDMA(HDMA5 bit7=0)を実行する: (n+1)*16バイトを即座に全転送する。
/// 転送1ブロックあたり8 T-cycleのBusTickで「CPU停止時間も加算」を表現する。
func HdmaRunGeneral(bus: *var Bus) {
    // 先に非アクティブにしておく(BusTick経由でPpuTickのHBlankフックが呼ばれても
    // 二重に転送を進めないようにするため)。
    bus.hdmaActive = false;
    while bus.hdmaRemaining > 0 {
        HdmaCopyBlock(bus);
        bus.hdmaRemaining -= 1;
        BusTick(bus, 8);
    }
}

/// HDMA5(FF55)への書き込みを処理する。進行中のHDMA(HBlank毎転送)にbit7=0を
/// 書くと中断し、残りブロック数を記録して以後のFF55読み出しに反映する。それ以外は
/// 新しい転送を開始する: bit7=1ならHDMA(HBlank待ち)、bit7=0ならGDMA(即時全転送)。
func HdmaStartOrCancel(bus: *var Bus, value: uint8) {
    if bus.hdmaActive && (value & 0x80) == 0 {
        bus.hdmaAborted = true;
        bus.hdmaAbortedRemaining = bus.hdmaRemaining;
        bus.hdmaActive = false;
        return;
    }
    let length = (((value & 0x7F) as int) + 1);
    bus.hdmaRemaining = length;
    bus.hdmaAborted = false;
    if (value & 0x80) != 0 {
        bus.hdmaActive = true; // HDMA: HBlank毎にPpuTick側から1ブロックずつ進む
    } else {
        bus.hdmaActive = false;
        HdmaRunGeneral(bus); // GDMA: ここで即時に全ブロック転送する
    }
}

/// PPU が Draw→HBlank へ遷移した瞬間に呼ぶ HDMA フック(HBlank毎に16バイト進む)。
/// LCD off中はPpuTick自体が早期returnするため、この関数に到達すること自体がない
/// (「LCD off中のHDMAは進まない」は自然に満たされる)。
pub func HdmaOnHblank(bus: *var Bus) {
    if bus.mode == GbMode::Cgb && bus.hdmaActive {
        HdmaCopyBlock(bus);
        bus.hdmaRemaining -= 1;
        if bus.hdmaRemaining <= 0 {
            bus.hdmaActive = false;
        }
    }
}

// --- CPU 側のメモリアクセス経路 ---

/// CPU からの1バイト読み出し。4 T-cycle 消費してから読む。
pub func CpuRead8(cpu: *Cpu, bus: *var Bus, addr: uint16) -> uint8 {
    BusTick(bus, 4);
    return BusRead(bus, addr);
}

/// CPU からの1バイト書き込み。4 T-cycle 消費してから書く。
pub func CpuWrite8(cpu: *Cpu, bus: *var Bus, addr: uint16, value: uint8) {
    BusTick(bus, 4);
    BusWrite(bus, addr, value);
}
