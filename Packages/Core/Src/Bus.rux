// メモリマップと M-cycle tick 駆動

import Core::Slice;

pub const OamSize: uint = 160;
pub const VramSize: uint = 8192;
pub const WramSize: uint = 8192;
pub const HramSize: uint = 127;
pub const IoSize: uint = 128;

pub const RomCapacity: uint = 32768; // Phase 1: 32KiB ROM-only
pub const SerialLogCapacity: uint = 16384;

pub struct Bus {
    pub mode: GbMode;
    pub rom: uint8[32768];
    pub romLength: uint;
    pub vram: uint8[8192];
    pub wram: uint8[8192];
    pub oam: uint8[160];
    pub hram: uint8[127];
    pub io: uint8[128];
    pub ie: uint8;
    pub cycles: uint64;
    pub hwCycles: uint64;
    pub doubleSpeed: bool;
    pub speedSwitchPrepared: bool;

    // Timer
    pub divCounter: uint16;
    pub tima: uint8;
    pub tma: uint8;
    pub tac: uint8;
    pub timerReloadPending: int;
    pub timerReloadJustHappened: bool;

    // Serial (Phase 1 T1-7)
    pub serialLog: uint8[16384];
    pub serialLogLength: uint;

    // PPU
    pub ppu: Ppu;

    // OAM DMA (FF46)
    pub dmaActive: bool;
    pub dmaSource: uint16;
    pub dmaIndex: int;
    pub dmaStartDelay: int;
    pub dmaPendingSource: uint16;
}

pub func BusInit(bus: *var Bus) {
    bus.mode = GbMode::Dmg;
    bus.romLength = 0;
    bus.ie = 0;
    bus.cycles = 0;
    bus.hwCycles = 0;
    bus.doubleSpeed = false;
    bus.speedSwitchPrepared = false;
    bus.divCounter = 0;
    bus.tima = 0;
    bus.tma = 0;
    bus.tac = 0;
    bus.timerReloadPending = 0;
    bus.timerReloadJustHappened = false;
    bus.serialLogLength = 0;
    bus.dmaActive = false;
    bus.dmaSource = 0;
    bus.dmaIndex = 0;
    bus.dmaStartDelay = 0;
    bus.dmaPendingSource = 0;

    var i: uint = 0;
    while i < IoSize {
        bus.io[i] = 0;
        i += 1;
    }
}

pub func BusLoadRom(bus: *var Bus, data: Slice<uint8>) -> bool {
    if data.length == 0 || data.length > RomCapacity {
        return false;
    }
    var i: uint = 0;
    while i < data.length {
        bus.rom[i] = data.data[i];
        i += 1;
    }
    bus.romLength = data.length;
    return true;
}

pub func BusPowerOn(bus: *var Bus) {
    PpuPowerOn(@bus.ppu);
}

// bus_tick は t_cycles ぶん時間を進める。CPU の全メモリアクセスごとに呼ばれる。
pub func BusTick(bus: *var Bus, tCycles: int) {
    let cyclesU = tCycles as uint64;
    bus.cycles += cyclesU;
    bus.hwCycles += cyclesU;

    TimerTick(bus, tCycles);
    PpuTick(bus, tCycles);

    var mCycles = tCycles / 4;
    while mCycles > 0 {
        DmaTickOneMcycle(bus);
        mCycles -= 1;
    }
}

// dma_tick_one_mcycle は OAM DMA を1 M-cycleぶん進める。
// 開始タイミング: M0でFF46書き込み(dma_start_delay=2をセットするのみ)、M1では
// まだ何も起きない、M2で新しい転送が開始し以後1バイト/M-cycleで160 M-cycleかけて
// 転送する。
func DmaTickOneMcycle(bus: *var Bus) {
    if bus.dmaStartDelay > 0 {
        bus.dmaStartDelay -= 1;
        if bus.dmaStartDelay == 0 {
            bus.dmaActive = true;
            bus.dmaSource = bus.dmaPendingSource;
            bus.dmaIndex = 0;
        }
    }

    if bus.dmaActive {
        bus.oam[bus.dmaIndex as uint] = BusReadRaw(bus, bus.dmaSource + (bus.dmaIndex as uint16));
        bus.dmaIndex += 1;
        if (bus.dmaIndex as uint) >= OamSize {
            bus.dmaActive = false;
        }
    }
}

func TimerSelectedBit(tac: uint8) -> uint {
    let speed = tac & 0x03;
    if speed == 0 { return 9; }
    else if speed == 1 { return 3; }
    else if speed == 2 { return 5; }
    return 7;
}

func TimerSignal(divider: uint16, tac: uint8) -> bool {
    if (tac & 0x04) == 0 { return false; }
    return (divider & ((1 as uint16) << TimerSelectedBit(tac))) != 0;
}

func TimerIncrementTima(bus: *var Bus) {
    if bus.timerReloadPending > 0 { return; }
    if bus.tima == 0xFF {
        bus.tima = 0;
        bus.timerReloadPending = 4;
    } else {
        bus.tima += 1;
    }
}

func TimerAdvanceReload(bus: *var Bus) {
    if bus.timerReloadPending <= 0 { return; }
    if bus.timerReloadPending == 1 {
        bus.timerReloadPending = 0;
        bus.tima = bus.tma;
        bus.timerReloadJustHappened = true;
        bus.io[0x0F] = bus.io[0x0F] | 0x04;
    } else {
        bus.timerReloadPending -= 1;
    }
}

func TimerTick(bus: *var Bus, tCycles: int) {
    bus.timerReloadJustHappened = false;
    var cycle: int = 0;
    while cycle < tCycles {
        TimerAdvanceReload(bus);
        let oldSignal = TimerSignal(bus.divCounter, bus.tac);
        bus.divCounter += 1;
        let newSignal = TimerSignal(bus.divCounter, bus.tac);
        if oldSignal && !newSignal {
            TimerIncrementTima(bus);
        }
        cycle += 1;
    }
}

// OAM DMA 中は CPU からの OAM 領域(FE00-FE9F)読み出しが 0xFF に化ける
// (DMA自身の内部読み出しはこの制限を受けない BusReadRaw を直接使う)。
pub func BusRead(bus: *Bus, addr: uint16) -> uint8 {
    if bus.dmaActive && addr >= 0xFE00 && addr <= 0xFE9F {
        return 0xFF;
    }
    return BusReadRaw(bus, addr);
}

pub func BusReadRaw(bus: *Bus, addr: uint16) -> uint8 {
    if addr <= 0x7FFF {
        if (addr as uint) < bus.romLength {
            return bus.rom[addr as uint];
        }
        return 0xFF;
    } else if addr <= 0x9FFF {
        return bus.vram[(addr - 0x8000) as uint];
    } else if addr <= 0xBFFF {
        return 0xFF; // Phase 1: 外部RAM未実装
    } else if addr <= 0xDFFF {
        return bus.wram[(addr - 0xC000) as uint];
    } else if addr <= 0xFDFF {
        return bus.wram[(addr - 0xE000) as uint]; // Echo RAM
    } else if addr <= 0xFE9F {
        return bus.oam[(addr - 0xFE00) as uint];
    } else if addr <= 0xFEFF {
        return 0xFF; // 未使用領域
    } else if addr <= 0xFF7F {
        return BusIoRead(bus, addr);
    } else if addr <= 0xFFFE {
        return bus.hram[(addr - 0xFF80) as uint];
    } else {
        return bus.ie; // 0xFFFF
    }
}

// OAM DMA 中は OAM 領域(FE00-FE9F)自身への書き込みだけを無視する。
pub func BusWrite(bus: *var Bus, addr: uint16, value: uint8) {
    if bus.dmaActive && addr >= 0xFE00 && addr <= 0xFE9F {
        return;
    }
    if addr <= 0x7FFF {
        // ROM: 書き込み無視 (Phase 1)
    } else if addr <= 0x9FFF {
        bus.vram[(addr - 0x8000) as uint] = value;
    } else if addr <= 0xBFFF {
        // 外部RAM未実装
    } else if addr <= 0xDFFF {
        bus.wram[(addr - 0xC000) as uint] = value;
    } else if addr <= 0xFDFF {
        bus.wram[(addr - 0xE000) as uint] = value;
    } else if addr <= 0xFE9F {
        bus.oam[(addr - 0xFE00) as uint] = value;
    } else if addr <= 0xFEFF {
        // 未使用
    } else if addr <= 0xFF7F {
        BusIoWrite(bus, addr, value);
    } else if addr <= 0xFFFE {
        bus.hram[(addr - 0xFF80) as uint] = value;
    } else {
        bus.ie = value; // 0xFFFF
    }
}

func BusIoRead(bus: *Bus, addr: uint16) -> uint8 {
    if addr == 0xFF04 {
        return (bus.divCounter >> 8) as uint8;
    } else if addr == 0xFF05 {
        return bus.tima;
    } else if addr == 0xFF06 {
        return bus.tma;
    } else if addr == 0xFF07 {
        return bus.tac | 0xF8;
    } else if addr == 0xFF0F {
        return bus.io[0x0F] | 0xE0;
    } else if addr == 0xFF01 || addr == 0xFF02 || addr == 0xFF46 {
        return bus.io[(addr - 0xFF00) as uint];
    } else if (addr >= 0xFF40 && addr <= 0xFF45) || (addr >= 0xFF47 && addr <= 0xFF4B) {
        // FF46 (OAM DMA) は PPU レジスタではないため対象外
        return PpuRead(bus, addr);
    }
    return 0xFF;
}

func BusIoWrite(bus: *var Bus, addr: uint16, value: uint8) {
    if addr == 0xFF04 {
        let oldSignal = TimerSignal(bus.divCounter, bus.tac);
        bus.divCounter = 0;
        if oldSignal {
            TimerIncrementTima(bus);
        }
    } else if addr == 0xFF05 {
        if !bus.timerReloadJustHappened {
            bus.timerReloadPending = 0;
            bus.tima = value;
        }
    } else if addr == 0xFF06 {
        bus.tma = value;
        if bus.timerReloadJustHappened {
            bus.tima = value;
        }
    } else if addr == 0xFF07 {
        let oldSignal = TimerSignal(bus.divCounter, bus.tac);
        bus.tac = value & 0x07;
        let newSignal = TimerSignal(bus.divCounter, bus.tac);
        if oldSignal && !newSignal {
            TimerIncrementTima(bus);
        }
    } else if addr == 0xFF0F {
        bus.io[0x0F] = value & 0x1F;
    } else if addr == 0xFF01 {
        bus.io[0x01] = value;
    } else if addr == 0xFF02 {
        SerialWrite(bus, addr, value);
    } else if addr == 0xFF46 {
        bus.io[0x46] = value; // 読み戻し用(mooneye oam_dma/reg_read)
        bus.dmaPendingSource = (value as uint16) << 8;
        bus.dmaStartDelay = 2; // 1 M-cycleの遅延後、2M-cycle目から新しい転送が始まる
    } else if (addr >= 0xFF40 && addr <= 0xFF45) || (addr >= 0xFF47 && addr <= 0xFF4B) {
        PpuWrite(bus, addr, value);
    } else {
        bus.io[(addr - 0xFF00) as uint] = value;
    }
}

// --- CPU 側のメモリアクセス経路 ---
pub func CpuRead8(cpu: *Cpu, bus: *var Bus, addr: uint16) -> uint8 {
    BusTick(bus, 4);
    return BusRead(bus, addr);
}

pub func CpuWrite8(cpu: *Cpu, bus: *var Bus, addr: uint16, value: uint8) {
    BusTick(bus, 4);
    BusWrite(bus, addr, value);
}
