/// POSIX(libc)への最小限のバインディング。ファイルI/O・argv・環境変数の取得に使う。
///
/// Rux標準ライブラリの `Storage`/`Path` パッケージはより高機能だが、`Allocator`/`OsString`
/// などの抽象を新たに導入するコストがフェーズ8のスコープに見合わないと判断し、既存の
/// `Packages/App/Src/Main.rux`(フェーズ0)や `Tests/Packages/Core/Blargg`
/// (`open`/`read`/`close`を自前で宣言)と同じ「必要最小限を自前で持つ」方針を踏襲した。
/// 署名は `man 2 <name>` および `/usr/include` のヘッダに基づく。macOS/Linuxの両方に対応する
/// (フェーズ9、Windowsは未対応)。ABIがOSごとに異なる箇所は`docs/dev/PLAN.md` 1.5参照。

import Core::{ Slice, #target, #Error };

when #target.os {
    .macOS => const LibC = "libSystem.B.dylib";
    .Linux => const LibC = "libc.so.6"; // glibc 2.34+ の推奨名(external/Rux/Packages/Linux/Src/Dynamic.rux参照)
    else => #Error("Unsupported operating system")
}

/// `mkdir`の`mode`引数の型。macOSは`mode_t`=`uint16`、Linuxは`unsigned int`(`uint32`)で
/// 幅が異なる(docs/dev/PLAN.md 1.5(b))。
when #target.os {
    .macOS => type ModeT = uint16;
    .Linux => type ModeT = uint32;
    else => #Error("Unsupported operating system")
}

#Link(LibC)
extern {
    func open(path: *char8, flags: int32, ...) -> int32;
    func close(fd: int32) -> int32;
    func read(fd: int32, buf: *var opaque, count: uint) -> int64;
    func write(fd: int32, buf: *opaque, count: uint) -> int64;
    func lseek(fd: int32, offset: int64, whence: int32) -> int64;
    func unlink(path: *char8) -> int32;
    func rename(oldPath: *char8, newPath: *char8) -> int32;
    func mkdir(path: *char8, mode: ModeT) -> int32;
    func access(path: *char8, mode: int32) -> int32;
    func getenv(name: *char8) -> *char8;
    func malloc(size: uint) -> *var opaque;
    func calloc(count: uint, size: uint) -> *var opaque;
    func free(ptr: *var opaque);
    func time(t: *var int64) -> int64;
}

// argv取得はOSごとに手段が異なる(macOSのみ_NSGetArgc/_NSGetArgvを持つ、下のArgv参照)ため、
// この宣言もmacOS専用としてOS分岐の中に閉じる。
when #target.os {
    .macOS => {
        #Link(LibC)
        extern {
            func _NSGetArgc() -> *var int32;
            func _NSGetArgv() -> *var *var *var char8;
        }
    }
    else => {}
}

pub const ORdOnly: int32 = 0x0000;
pub const OWrOnly: int32 = 0x0001;

/// `O_CREAT`/`O_TRUNC`のビット位置はDarwinとLinuxで異なる(docs/dev/PLAN.md 1.5(a))。
/// 値をDarwinのまま流用すると`O_CREAT`が立たず、新規ファイル作成が黙って失敗する。
when #target.os {
    .macOS => {
        pub const OCreat: int32 = 0x0200;
        pub const OTrunc: int32 = 0x0400;
    }
    .Linux => {
        pub const OCreat: int32 = 0x0040;
        pub const OTrunc: int32 = 0x0200;
    }
    else => #Error("Unsupported operating system")
}

pub const SeekSet: int32 = 0;
pub const SeekEnd: int32 = 2;
pub const FOk: int32 = 0;

/// null終端の`*char8`をバイト長を数えて`Slice<char8>`にする(終端は含まない)。
pub func CStrToSlice(s: *char8) -> Slice<char8> {
    var len: uint = 0;
    while *(s + len) != 0 {
        len += 1;
    }
    return Slice<char8> { data: s, length: len };
}

pub func PathExists(path: *char8) -> bool {
    return access(path, FOk) == 0;
}

/// `path`を丸ごと読み込む。`length`に読み込んだバイト数を書く。所有権は呼び出し側に移る
/// (`free`すること)。失敗時は null を返す。
pub func ReadEntireFile(path: *char8, length: *var uint) -> *var uint8 {
    let fd = open(path, ORdOnly);
    if fd < 0 {
        *length = 0;
        return null;
    }
    let size = lseek(fd, 0, SeekEnd);
    if size < 0 {
        close(fd);
        *length = 0;
        return null;
    }
    lseek(fd, 0, SeekSet);

    let buf = calloc((size as uint) + 1, 1) as *var uint8;
    if buf == null {
        close(fd);
        *length = 0;
        return null;
    }

    var total: int64 = 0;
    while total < size {
        let n = read(fd, (buf + (total as uint)) as *var opaque, (size - total) as uint);
        if n <= 0 { break; }
        total += n;
    }
    close(fd);
    *length = total as uint;
    return buf;
}

/// `data`を`path`へ書き込む(単純上書き。存在しなければ作成)。
func WriteFileRaw(path: *char8, data: *uint8, length: uint) -> bool {
    let fd = open(path, OWrOnly | OCreat | OTrunc, 0x1A4 as int32); // 0644
    if fd < 0 { return false; }
    var total: uint = 0;
    var ok = true;
    while total < length {
        let n = write(fd, (data + total) as *opaque, length - total);
        if n <= 0 { ok = false; break; }
        total += n as uint;
    }
    close(fd);
    return ok;
}

/// アトミック書き込み: 一時ファイル(`path`+".tmp")に書いてから`path`へリネームする
/// (書き込み中のクラッシュで既存ファイルを壊さない、
/// `~/dev/_Emu/BubiBoyLite/src/app/saveram.odin`の`save_ram_write_atomic`と同じ方式。
/// バックアップ(.bak)への退避は行わない — renameが同一ファイルシステム上でアトミックである
/// ことに依拠し、「一時ファイル書き込み失敗時に既存ファイルへ影響しない」という核心の保証は
/// 変わらないため、フェーズ8のスコープでは簡略化した)。
pub func WriteFileAtomic(path: *char8, tmpPath: *char8, data: *uint8, length: uint) -> bool {
    if !WriteFileRaw(tmpPath, data, length) {
        return false;
    }
    if rename(tmpPath, path) != 0 {
        unlink(tmpPath);
        return false;
    }
    return true;
}

/// Linux: `/proc/self/cmdline`はNUL区切りの引数リスト(末尾もNUL)を持つ(procfsの規約)。
/// argvをシステムコールで直接得る手段が無いため(`__libc_argv`はGLIBC_PRIVATE、
/// docs/dev/PLAN.md 1.5(c))、ここから読み出して`*var *var char8`の形に組み立てる。
/// 返す配列・各文字列はプロセス終了まで生き続ける前提でfreeしない
/// (macOS版の`_NSGetArgv`が指す領域も同様に呼び出し元は解放しない)。
func LinuxArgv(argcOut: *var int32) -> *var *var char8 {
    let fd = open("/proc/self/cmdline\0".data, ORdOnly);
    if fd < 0 {
        *argcOut = 0;
        return null;
    }

    const BufCap: uint = 65536;
    let buf = calloc(BufCap, 1) as *var uint8;
    var total: uint = 0;
    while total < BufCap - 1 {
        let n = read(fd, (buf + total) as *var opaque, BufCap - 1 - total);
        if n <= 0 { break; }
        total += n as uint;
    }
    close(fd);

    var argc: int32 = 0;
    var i: uint = 0;
    while i < total {
        argc += 1;
        while i < total && *(buf + i) != 0 { i += 1; }
        i += 1;
    }

    let argv = calloc((argc as uint) + 1, sizeof(uint)) as *var *var char8;
    var argIndex: uint = 0;
    i = 0;
    while i < total && (argIndex as int32) < argc {
        *(argv + argIndex) = (buf + i) as *var char8;
        while i < total && *(buf + i) != 0 { i += 1; }
        i += 1;
        argIndex += 1;
    }

    *argcOut = argc;
    return argv;
}

/// argv(先頭のプログラム名を含む)を返す。
pub func Argv(argc: *var int32) -> *var *var char8 {
    when #target.os {
        .macOS => {
            *argc = *_NSGetArgc();
            return *_NSGetArgv();
        }
        .Linux => {
            return LinuxArgv(argc);
        }
        else => {
            *argc = 0;
            return null;
        }
    }
}

pub func GetEnv(name: *char8) -> *char8 {
    return getenv(name);
}

/// 現在時刻をUNIX秒で返す(`MbcSyncWallClock`へ供給する。coreは時計を直接読まない方針
/// のため、壁時計の取得はapp側の責務 — `~/dev/_Emu/BubiBoyLite/src/app/saveram.odin`の
/// `wall_clock_now`と同じ位置づけ)。
pub func WallClockNow() -> int64 {
    return time(null);
}

/// ディレクトリを作成する(既存なら成功扱い)。深さ1つ(親は既存前提)のみ対応。
pub func EnsureDirectory(path: *char8) -> bool {
    if PathExists(path) { return true; }
    return mkdir(path, 0x1ED as ModeT) == 0; // 0755
}
