/// RuxBoy — フェーズ8: フロントエンド(CLI/設定/セーブRAM/オーディオ同期ゲームループ)。
/// フェーズ0の最小ウィンドウ表示スケルトンを置き換える。

import Core::Slice;
import GbCore::{
    Cpu, Bus, GbMode,
    CpuReset, BusInit, BusLoadRom, BusPowerOn, CpuStep,
    MbcSyncWallClock,
};
import Sdl3::{
    SdlInitVideo, SdlInitAudio,
    SdlEvent, SdlEventQuit, SdlEventKeyDown, SdlEventKeyUp,
    SdlScancodeEscape, SdlScancodeF1, SdlScancodeF3,
    SDL_SetMainReady, SDL_Init, SDL_Quit, SDL_PollEvent,
};

const AppTitle: Slice<char8> = "RuxBoy\0";
const FrameTCycles: uint64 = 70224;
const MaxArgs: uint = 32;

func Print(text: Slice<char8>) {
    PlatformWrite(1, text.data as *opaque, text.length as uint);
}

func PrintLine(text: Slice<char8>) {
    Print(text);
    Print("\n");
}

func Main() -> int {
    EnsureUtf8Console();

    var argc: int32 = 0;
    let argv = Argv(@argc);

    var argSlices: Slice<char8>[32];
    var argCount: uint = 0;
    var i: int32 = 1;
    while i < argc && argCount < MaxArgs {
        argSlices[argCount] = CStrToSlice(*(argv + i));
        argCount += 1;
        i += 1;
    }

    let opts = ParseArgs(@argSlices[0], argCount);

    if opts.showHelp {
        Print(Usage);
        return 0;
    }
    if opts.showVersion {
        PrintLine("RuxBoy 0.1.0");
        return 0;
    }
    if !opts.ok {
        PrintLine(opts.errorMessage);
        return 2;
    }

    var config = ConfigLoad();
    let scale = opts.scaleProvided ? opts.scale : config.scale;
    let fullscreen = opts.fullscreenProvided ? opts.fullscreen : config.fullscreen;
    let smooth = opts.smoothProvided ? opts.smooth : config.smooth;

    if opts.recent {
        RecentPrint();
        return 0;
    }

    if !opts.hasRomPath {
        Print(Usage);
        return 2;
    }

    var romPathBuf: PathBuf;
    PathBufClear(@romPathBuf);
    PathBufAppend(@romPathBuf, opts.romPath);
    let romPath = PathBufCStr(@romPathBuf);

    var romLength: uint = 0;
    let romData = ReadEntireFile(romPath, @romLength);
    if romData == null {
        Print("ROMを読み込めません: ");
        PrintLine(opts.romPath);
        return 1;
    }

    var cpu: Cpu;
    var bus: Bus;
    BusInit(@bus);
    if !BusLoadRom(@bus, Slice<uint8> { data: romData, length: romLength }) {
        PrintLine("ROMヘッダが不正です");
        free(romData as *var opaque);
        return 1;
    }
    CpuReset(@cpu, bus.mode);
    BusPowerOn(@bus);
    MbcSyncWallClock(@bus.cart, WallClockNow() as uint64);

    LoadSaveRam(@bus, opts.romPath);
    RecentTouch(opts.romPath);

    SDL_SetMainReady();
    if !SDL_Init(SdlInitVideo) {
        PrintLine("SDL_Init(Video) に失敗しました");
        free(romData as *var opaque);
        return 1;
    }
    // オーディオは別呼び出しにする: SDL_Initへ複数フラグをまとめて渡すと
    // いずれかのサブシステムが失敗しただけで全体がfalseを返す。オーディオ
    // デバイスが無い環境(CI/一部のヘッドレス環境等)でも映像は表示・動作
    // できるよう、オーディオ初期化の失敗は非致命的として扱う(以後の
    // `AudioInit`/`AudioPushFrame`/`AudioPace`はstream==nullを許容する設計)。
    if !SDL_Init(SdlInitAudio) {
        PrintLine("SDL_Init(Audio) に失敗しました。音声なしで続行します。");
    }

    var video = VideoInit(AppTitle.data, scale, fullscreen, smooth, opts.headless);
    if !VideoIsValid(@video) {
        PrintLine("ウィンドウ/レンダラの作成に失敗しました");
        SDL_Quit();
        free(romData as *var opaque);
        return 1;
    }

    var audio = AudioInit();

    var running = true;
    var frameCount: int32 = 0;

    // バッテリーセーブの保存タイミング(移植元:
    // `~/dev/_Emu/BubiBoyLite/src/app/main.odin`のsave_pending/save_idle_frames):
    // 実書き込みからSaveIdleFramesフレーム(約1秒)書き込みが無かったら保存する。
    // 毎フレーム保存すると128KiB書き込み+renameを60Hzで行うことになるため。
    const SaveIdleFrames: int32 = 60;
    var savePending = false;
    var saveIdleFrames: int32 = 0;

    while running {
        if opts.headless && frameCount >= opts.frames { break; }

        var event: SdlEvent;
        while SDL_PollEvent(@event) {
            if event.kind == SdlEventQuit {
                running = false;
            } else if event.kind == SdlEventKeyDown {
                if event.scancode == SdlScancodeEscape {
                    running = false;
                } else if event.scancode == SdlScancodeF1 && !event.repeat {
                    SaveStateToFile(@cpu, @bus, opts.romPath);
                } else if event.scancode == SdlScancodeF3 && !event.repeat {
                    LoadStateFromFile(@cpu, @bus, opts.romPath);
                } else {
                    HandleKeyEvent(@bus, event.scancode, true);
                }
            } else if event.kind == SdlEventKeyUp {
                HandleKeyEvent(@bus, event.scancode, false);
            }
        }

        // bus.cyclesはCPU生T-cycle(倍速中も半分にならない)。フレーム境界は
        // 実ハードウェア時間(PPU/APUの供給レート)で区切る必要があるため、
        // 倍速中に半分だけ進むbus.hwCyclesを使う(bus.cyclesを使うと倍速中は
        // 1回のループが実ハードウェア半フレーム分しか進めず、映像更新も
        // オーディオ生成量も本来の半分になってしまう)。
        let frameStart = bus.hwCycles;
        while bus.hwCycles - frameStart < FrameTCycles {
            CpuStep(@cpu, @bus);
        }

        // MBC3のRTCは呼び出し間の経過秒しか進めない(`MbcSyncWallClock`参照)ため、
        // 起動時の1回だけでは止まったままになる。毎フレーム供給し続ける。
        MbcSyncWallClock(@bus.cart, WallClockNow() as uint64);

        VideoPresent(@video, @bus.ppu.framebuffer[0]);

        AudioPushFrame(@audio, @bus.apu, config.volume);

        if bus.cart.ramDirty {
            savePending = true;
            saveIdleFrames = 0;
            bus.cart.ramDirty = false;
        } else if savePending {
            saveIdleFrames += 1;
            if saveIdleFrames >= SaveIdleFrames {
                SaveSaveRam(@bus, opts.romPath);
                savePending = false;
                saveIdleFrames = 0;
            }
        }

        if !opts.headless {
            AudioPace(@audio);
        }

        frameCount += 1;
    }

    if opts.hasScreenshotPath {
        var shotBuf: PathBuf;
        PathBufClear(@shotBuf);
        PathBufAppend(@shotBuf, opts.screenshotPath);
        VideoScreenshot(@video, PathBufCStr(@shotBuf));
    }

    SaveSaveRam(@bus, opts.romPath);

    AudioDestroy(@audio);
    VideoDestroy(@video);
    SDL_Quit();
    free(romData as *var opaque);

    return 0;
}
