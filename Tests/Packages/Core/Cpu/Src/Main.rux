import GbCore::{
    Cpu, GbMode,
    CpuSetFlags, CpuFlagZ, CpuFlagN, CpuFlagH, CpuFlagC,
    CpuReset
};

func Main() -> int {
    var cpu: Cpu;

    // Test 1: Register pair AF (F lower 4 bits masked)
    cpu.af.word = 0x1234 & 0xFFF0;
    if cpu.af.bytes.hi != 0x12 { return 1; }
    if cpu.af.bytes.lo != 0x30 { return 2; }
    if cpu.af.word != 0x1230 { return 3; }

    // Test 2: Register pair BC
    cpu.bc.word = 0xABCD;
    if cpu.bc.bytes.hi != 0xAB { return 4; }
    if cpu.bc.bytes.lo != 0xCD { return 5; }
    if cpu.bc.word != 0xABCD { return 6; }

    // Test 3: Register pair DE
    cpu.de.word = 0x5678;
    if cpu.de.bytes.hi != 0x56 { return 7; }
    if cpu.de.bytes.lo != 0x78 { return 8; }
    if cpu.de.word != 0x5678 { return 9; }

    // Test 4: Register pair HL
    cpu.hl.word = 0x9ABC;
    if cpu.hl.bytes.hi != 0x9A { return 10; }
    if cpu.hl.bytes.lo != 0xBC { return 11; }
    if cpu.hl.word != 0x9ABC { return 12; }

    // Test 5: Flags
    CpuSetFlags(@cpu, true, false, true, false);
    if !CpuFlagZ(@cpu) { return 13; }
    if CpuFlagN(@cpu) { return 14; }
    if !CpuFlagH(@cpu) { return 15; }
    if CpuFlagC(@cpu) { return 16; }

    CpuSetFlags(@cpu, false, true, false, true);
    if CpuFlagZ(@cpu) { return 17; }
    if !CpuFlagN(@cpu) { return 18; }
    if CpuFlagH(@cpu) { return 19; }
    if !CpuFlagC(@cpu) { return 20; }

    // Test 6: Reset DMG
    CpuReset(@cpu, GbMode::Dmg);
    if cpu.af.word != 0x01B0 { return 21; }
    if cpu.bc.word != 0x0013 { return 22; }
    if cpu.de.word != 0x00D8 { return 23; }
    if cpu.hl.word != 0x014D { return 24; }
    if cpu.sp != 0xFFFE { return 25; }
    if cpu.pc != 0x0100 { return 26; }

    // Test 7: Reset CGB
    CpuReset(@cpu, GbMode::Cgb);
    if cpu.af.word != 0x1180 { return 27; }
    if cpu.bc.word != 0x0000 { return 28; }
    if cpu.de.word != 0xFF56 { return 29; }
    if cpu.hl.word != 0x000D { return 30; }
    if cpu.sp != 0xFFFE { return 31; }
    if cpu.pc != 0x0100 { return 32; }

    return 0;
}
