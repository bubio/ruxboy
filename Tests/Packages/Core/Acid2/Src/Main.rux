import Core::Slice;
import GbCore::{
    Cpu, Bus, GbMode, CyclesPerFrame,
    CpuReset, BusInit, BusPowerOn, BusLoadRom, CpuStep
};

// dmg-acid2 のフレームバッファハッシュ判定(BubiBoy Lite tests/acid2_test.odin と同じ方式)。
// 100フレーム実行後の framebuffer(uint32[23040]、ARGB)をリトルエンディアンのバイト列として
// FNV-1a 64bit ハッシュ化し、期待値と比較する。期待値はBubiBoy Lite側で同じ手順・同じROM
// (mattcurrie/dmg-acid2 v1.0 リリース同梱)で目視確認済みの値をそのまま流用する
// (PPU描画ロジックはppu.odinの忠実な移植のため、一致すれば移植の正しさの強い裏付けになる)。

#Link("libSystem.B.dylib")
extern {
    func open(path: *char8, flags: int32, ...) -> int32;
    func read(fd: int32, buf: *var opaque, count: uint) -> int64;
    func close(fd: int32) -> int32;
    func write(fd: int32, buf: *opaque, count: uint) -> int64;
}

func Print(text: Slice<char8>) {
    write(1, text.data as *opaque, text.length);
}

func PrintLine(text: Slice<char8>) {
    Print(text);
    Print("\n");
}

func PrintHex64(value: uint64) {
    let digits: Slice<char8> = "0123456789ABCDEF";
    var buf: char8[16];
    var i: int = 15;
    var v = value;
    while i >= 0 {
        buf[i as uint] = digits.data[(v & 0xF) as uint];
        v = v >> 4;
        i -= 1;
    }
    write(1, @buf[0] as *opaque, 16);
}

func OpenRom(path: Slice<char8>) -> int32 {
    var fd = open(path.data, 0); // O_RDONLY
    if fd >= 0 { return fd; }

    var buf: char8[256];
    let prefix: Slice<char8> = "../../../../";
    var i: uint = 0;
    while i < prefix.length {
        buf[i] = prefix.data[i];
        i += 1;
    }
    var j: uint = 0;
    while j < path.length {
        buf[i + j] = path.data[j];
        j += 1;
    }
    buf[i + j] = c8'\0';
    return open(@buf[0], 0);
}

const ExpectedHash: uint64 = 0x17A0F9970AC4D084u64;
const FnvOffsetBasis: uint64 = 0xcbf29ce484222325u64;
const FnvPrime: uint64 = 0x100000001b3u64;

func FnvByte(hash: uint64, b: uint8) -> uint64 {
    return (hash ^ (b as uint64)) * FnvPrime;
}

func Main() -> int {
    PrintLine("=== Running dmg-acid2 Framebuffer Hash Test ===");

    let path: Slice<char8> = "tests/roms/acid2/dmg-acid2.gb\0";
    let fd = OpenRom(path);
    if fd < 0 {
        PrintLine("ROM not found (skipped): tests/roms/acid2/dmg-acid2.gb");
        return 0;
    }

    var romData: uint8[32768];
    let bytesRead = read(fd, @romData[0] as *var opaque, 32768u);
    close(fd);
    if bytesRead <= 0 {
        PrintLine("Failed to read ROM: dmg-acid2.gb");
        return 1;
    }

    var cpu: Cpu;
    var bus: Bus;
    CpuReset(@cpu, GbMode::Dmg);
    BusInit(@bus);
    BusPowerOn(@bus);
    if !BusLoadRom(@bus, Slice<uint8> { data: @romData[0], length: bytesRead as uint }) {
        PrintLine("Failed to load ROM: dmg-acid2.gb");
        return 1;
    }

    let targetCycles: uint64 = CyclesPerFrame * 100u64;
    while bus.cycles < targetCycles {
        CpuStep(@cpu, @bus);
    }

    var hash: uint64 = FnvOffsetBasis;
    var i: uint = 0;
    while i < 23040u {
        let px = bus.ppu.framebuffer[i];
        hash = FnvByte(hash, (px & 0xFF) as uint8);
        hash = FnvByte(hash, ((px >> 8) & 0xFF) as uint8);
        hash = FnvByte(hash, ((px >> 16) & 0xFF) as uint8);
        hash = FnvByte(hash, ((px >> 24) & 0xFF) as uint8);
        i += 1;
    }

    if hash == ExpectedHash {
        PrintLine("PASS: dmg-acid2 framebuffer hash matches");
        return 0;
    }
    Print("FAIL: dmg-acid2 framebuffer hash mismatch got=0x");
    PrintHex64(hash);
    Print(" expected=0x");
    PrintHex64(ExpectedHash);
    PrintLine("");
    return 1;
}
