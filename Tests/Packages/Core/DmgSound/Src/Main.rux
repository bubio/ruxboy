// Blargg dmg_sound テストROMランナー。cpu_instrs系(BlarggTest)と違い、
// dmg_soundは結果をシリアルではなく外部RAM(MBC1+RAM+BATTERY)の0xA000に書く
// (ROM同梱readme.txt記載の方式)。0xA001-3が signature 0xDE,0xB0,0x61 なら
// 0xA000 が有効な結果コード(実行中は0x80、終了後は最終コード。0=PASS)。

import Core::Slice;
import GbCore::{
    Cpu, Bus, GbMode,
    CpuReset, BusInit, BusPowerOn, BusLoadRom, CpuStep,
    BusRead
};

#Link("libSystem.B.dylib")
extern {
    func open(path: *char8, flags: int32, ...) -> int32;
    func read(fd: int32, buf: *var opaque, count: uint) -> int64;
    func close(fd: int32) -> int32;
    func write(fd: int32, buf: *opaque, count: uint) -> int64;
}

func Print(text: Slice<char8>) {
    write(1, text.data as *opaque, text.length);
}

func PrintLine(text: Slice<char8>) {
    Print(text);
    Print("\n");
}

func RunDmgSoundRom(path: Slice<char8>, name: Slice<char8>, timeoutTCycles: uint64) -> bool {
    var fd = open(path.data, 0); // O_RDONLY
    if fd < 0 {
        var buf: char8[256];
        let prefix: Slice<char8> = "../../../../";
        var p: uint = 0;
        while p < prefix.length {
            buf[p] = prefix.data[p];
            p += 1;
        }
        var q: uint = 0;
        while q < path.length {
            buf[p + q] = path.data[q];
            q += 1;
        }
        buf[p + q] = c8'\0';
        fd = open(@buf[0], 0);
    }

    if fd < 0 {
        Print("ROM not found (skipped): ");
        PrintLine(name);
        return true; // ROM未取得時はスキップ扱い
    }

    var romData: uint8[65536];
    let bytesRead = read(fd, @romData[0] as *var opaque, 65536u);
    close(fd);

    if bytesRead <= 0 {
        Print("Failed to read ROM: ");
        PrintLine(name);
        return false;
    }

    var cpu: Cpu;
    var bus: Bus;
    CpuReset(@cpu, GbMode::Dmg);
    BusInit(@bus);
    BusPowerOn(@bus);
    BusLoadRom(@bus, Slice<uint8> { data: @romData[0], length: bytesRead as uint });

    let timeout = timeoutTCycles;
    var finished = false;
    var resultCode: uint8 = 0x80;

    while bus.cycles < timeout && !finished {
        CpuStep(@cpu, @bus);

        let sig1 = BusRead(@bus, 0xA001);
        let sig2 = BusRead(@bus, 0xA002);
        let sig3 = BusRead(@bus, 0xA003);
        if sig1 == 0xDE && sig2 == 0xB0 && sig3 == 0x61 {
            let code = BusRead(@bus, 0xA000);
            if code != 0x80 {
                resultCode = code;
                finished = true;
            }
        }
    }

    if finished && resultCode == 0 {
        Print("PASS: ");
        PrintLine(name);
        return true;
    } else {
        Print("FAIL: ");
        PrintLine(name);
        return false;
    }
}

func Main() -> int {
    PrintLine("=== Running Blargg dmg_sound Tests ===");

    var allPassed = true;
    let timeout: uint64 = 120000000;

    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/01-registers.gb\0", "01-registers", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/02-len ctr.gb\0", "02-len ctr", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/03-trigger.gb\0", "03-trigger", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/04-sweep.gb\0", "04-sweep", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/05-sweep details.gb\0", "05-sweep details", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/06-overflow on trigger.gb\0", "06-overflow on trigger", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/07-len sweep period sync.gb\0", "07-len sweep period sync", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/08-len ctr during power.gb\0", "08-len ctr during power", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/09-wave read while on.gb\0", "09-wave read while on", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/10-wave trigger while on.gb\0", "10-wave trigger while on", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/11-regs after power.gb\0", "11-regs after power", timeout) { allPassed = false; }
    if !RunDmgSoundRom("tests/roms/blargg/dmg_sound/rom_singles/12-wave write while on.gb\0", "12-wave write while on", timeout) { allPassed = false; }

    if allPassed {
        PrintLine("=== All dmg_sound Tests Passed! ===");
        return 0;
    } else {
        PrintLine("=== Some Tests Failed! ===");
        return 1;
    }
}
