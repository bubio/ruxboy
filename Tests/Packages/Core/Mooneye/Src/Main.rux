import Core::{ Slice, #target, #Error };
import GbCore::{
    Cpu, Bus, GbMode,
    CpuReset, BusInit, BusPowerOn, BusLoadRom, CpuStep
};

when #target.os {
    .macOS => const LibC = "libSystem.B.dylib";
    .Linux => const LibC = "libc.so.6";
    .Windows => const LibC = "ucrtbase.dll";
    else => #Error("Unsupported operating system")
}

// Windows: ucrtbaseはPOSIX名(open/read/close/write)を公開せず、<io.h>の
// アンダースコア付き名前(_open等)のみ提供する。O_BINARYはWindows既定のテキスト
// モード(CRLF変換)を無効化する(付けないとROMバイナリが黙って壊れる、docs/dev/PLAN.md参照)。
when #target.os {
    .Windows => {
        pub const OBinary: int32 = 0x8000;
        #Link(LibC)
        extern {
            func _open(path: *char8, flags: int32, ...) -> int32;
            func _read(fd: int32, buf: *var opaque, count: uint32) -> int32;
            func _close(fd: int32) -> int32;
            func _write(fd: int32, buf: *opaque, count: uint32) -> int32;
        }
    }
    else => {
        pub const OBinary: int32 = 0;
        #Link(LibC)
        extern {
            func open(path: *char8, flags: int32, ...) -> int32;
            func read(fd: int32, buf: *var opaque, count: uint) -> int64;
            func close(fd: int32) -> int32;
            func write(fd: int32, buf: *opaque, count: uint) -> int64;
        }
    }
}

func POpen(path: *char8, flags: int32) -> int32 {
    when #target.os == .Windows { return _open(path, flags | OBinary); } else { return open(path, flags); }
}
func PRead(fd: int32, buf: *var opaque, count: uint) -> int64 {
    when #target.os == .Windows { return _read(fd, buf, count as uint32) as int64; } else { return read(fd, buf, count); }
}
func PClose(fd: int32) -> int32 {
    when #target.os == .Windows { return _close(fd); } else { return close(fd); }
}
func PWrite(fd: int32, buf: *opaque, count: uint) -> int64 {
    when #target.os == .Windows { return _write(fd, buf, count as uint32) as int64; } else { return write(fd, buf, count); }
}

func Print(text: Slice<char8>) {
    PWrite(1, text.data as *opaque, text.length);
}

func PrintLine(text: Slice<char8>) {
    Print(text);
    Print("\n");
}

func PrintHex(value: uint8) {
    let digits: Slice<char8> = "0123456789ABCDEF";
    var buf: char8[2];
    buf[0] = digits.data[(value >> 4) as uint];
    buf[1] = digits.data[(value & 0x0F) as uint];
    PWrite(1, @buf[0] as *opaque, 2);
}

func OpenRom(path: Slice<char8>) -> int32 {
    var fd = POpen(path.data, 0); // O_RDONLY
    if fd >= 0 { return fd; }

    var buf: char8[256];
    let prefix: Slice<char8> = "../../../../";
    var i: uint = 0;
    while i < prefix.length {
        buf[i] = prefix.data[i];
        i += 1;
    }
    var j: uint = 0;
    while j < path.length {
        buf[i + j] = path.data[j];
        j += 1;
    }
    buf[i + j] = c8'\0';
    return POpen(@buf[0], 0);
}

func RunMooneyeRom(path: Slice<char8>, name: Slice<char8>, expectedPass: bool, failReason: Slice<char8>) -> bool {
    let fd = OpenRom(path);
    if fd < 0 {
        Print("ROM not found (skipped): ");
        PrintLine(name);
        return true;
    }

    var romData: uint8[32768];
    let bytesRead = PRead(fd, @romData[0] as *var opaque, 32768u);
    PClose(fd);
    if bytesRead <= 0 {
        Print("Failed to read ROM: ");
        PrintLine(name);
        return false;
    }

    var cpu: Cpu;
    var bus: Bus;
    CpuReset(@cpu, GbMode::Dmg);
    BusInit(@bus);
    BusPowerOn(@bus);
    if !BusLoadRom(@bus, Slice<uint8> { data: @romData[0], length: bytesRead as uint }) {
        Print("Failed to load ROM: ");
        PrintLine(name);
        return false;
    }
    cpu.debugBreakOnLdBb = true;

    let timeout: uint64 = 120000000;
    while bus.cycles < timeout {
        CpuStep(@cpu, @bus);
        if cpu.ldBbHit {
            if cpu.bc.bytes.hi == 3 && cpu.bc.bytes.lo == 5 && cpu.de.bytes.hi == 8 && cpu.de.bytes.lo == 13 && cpu.hl.bytes.hi == 21 && cpu.hl.bytes.lo == 34 {
                if !expectedPass {
                    Print("UNEXPECTED PASS (remove from expected failure list): ");
                    PrintLine(name);
                    return false;
                }
                Print("PASS: ");
                PrintLine(name);
                return true;
            }
            if !expectedPass {
                Print("EXPECTED FAIL (");
                Print(failReason);
                Print("): ");
                PrintLine(name);
                return true;
            }
            Print("FAIL: ");
            Print(name);
            Print(" (B=");
            PrintHex(cpu.bc.bytes.hi);
            Print(" C=");
            PrintHex(cpu.bc.bytes.lo);
            Print(" D=");
            PrintHex(cpu.de.bytes.hi);
            Print(" E=");
            PrintHex(cpu.de.bytes.lo);
            Print(" H=");
            PrintHex(cpu.hl.bytes.hi);
            Print(" L=");
            PrintHex(cpu.hl.bytes.lo);
            Print(" TIMA=");
            PrintHex(bus.tima);
            Print(" DIV=");
            PrintHex((bus.divCounter >> 8) as uint8);
            Print(" TAC=");
            PrintHex(bus.tac);
            Print(" IF=");
            PrintHex(bus.io[0x0F]);
            Print(" IE=");
            PrintHex(bus.ie);
            PrintLine(")");
            return false;
        }
    }

    if !expectedPass {
        Print("EXPECTED FAIL (");
        Print(failReason);
        Print(", timeout): ");
        PrintLine(name);
        return true;
    }
    Print("TIMEOUT: ");
    PrintLine(name);
    return false;
}

func Main() -> int {
    PrintLine("=== Running Mooneye Acceptance Tests (Timer + Interrupts) ===");

    var allPassed = true;
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/div_write.gb\0", "div_write", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/rapid_toggle.gb\0", "rapid_toggle", false, "known timer timing difference") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim00.gb\0", "tim00", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim00_div_trigger.gb\0", "tim00_div_trigger", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim01.gb\0", "tim01", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim01_div_trigger.gb\0", "tim01_div_trigger", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim10.gb\0", "tim10", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim10_div_trigger.gb\0", "tim10_div_trigger", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim11.gb\0", "tim11", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tim11_div_trigger.gb\0", "tim11_div_trigger", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tima_reload.gb\0", "tima_reload", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tima_write_reloading.gb\0", "tima_write_reloading", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/timer/tma_write_reloading.gb\0", "tma_write_reloading", true, "") { allPassed = false; }

    if !RunMooneyeRom("tests/roms/mooneye/acceptance/ei_sequence.gb\0", "ei_sequence", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/ei_timing.gb\0", "ei_timing", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/halt_ime0_ei.gb\0", "halt_ime0_ei", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/halt_ime0_nointr_timing.gb\0", "halt_ime0_nointr_timing", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/halt_ime1_timing.gb\0", "halt_ime1_timing", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/if_ie_registers.gb\0", "if_ie_registers", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/intr_timing.gb\0", "intr_timing", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/rapid_di_ei.gb\0", "rapid_di_ei", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/reti_intr_timing.gb\0", "reti_intr_timing", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/reti_timing.gb\0", "reti_timing", false, "known OAM DMA + RETI timing difference") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/interrupts/ie_push.gb\0", "ie_push", true, "") { allPassed = false; }

    if !RunMooneyeRom("tests/roms/mooneye/acceptance/ppu/stat_irq_blocking.gb\0", "stat_irq_blocking", true, "") { allPassed = false; }
    if !RunMooneyeRom("tests/roms/mooneye/acceptance/ppu/stat_lyc_onoff.gb\0", "stat_lyc_onoff", false, "known LCD on/off LYC comparator edge case") { allPassed = false; }

    if allPassed {
        PrintLine("=== All Mooneye Tests Passed! ===");
        return 0;
    }
    PrintLine("=== Some Mooneye Tests Failed! ===");
    return 1;
}
